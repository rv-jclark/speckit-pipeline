#!/usr/bin/env bash
#
# spec-bootstrap — make a repository ready for spec-run.
#
# Installs the vendored spec-kit assets: the phase skills into .claude/skills/
# and the scaffold into .specify/. Idempotent, and it never overwrites content
# the project authored — a constitution is the project's own assertion about how
# it works, and silently replacing it with a template is the one unrecoverable
# thing this script could do.

set -uo pipefail

SPECKIT_PIPELINE_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export SPECKIT_PIPELINE_ROOT
# shellcheck source=../lib/common.sh
. "$SPECKIT_PIPELINE_ROOT/lib/common.sh"

ASSETS="$SPECKIT_PIPELINE_ROOT/assets"
FORCE=0
TARGET=""

while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=1; shift;;
    --version) pipeline_version; exit 0;;
    -h|--help)
      cat <<'EOF'
spec-bootstrap — install the spec-kit scaffold into a repository

USAGE
  spec-bootstrap [--force] [path]

  path      repository to bootstrap (default: git toplevel of cwd)
  --force   replace vendored files that already exist and differ. Per FILE:
            it only ever writes paths the bundle ships, so anything else under
            .specify/ or .claude/skills/ is left where it is.
            Never touches .specify/memory/, .specify/feature.json,
            .specify/integration.json or .specify/templates/overrides/.
EOF
      exit 0;;
    -*) die "unknown option: $1";;
    *)  TARGET="$1"; shift;;
  esac
done

[ -d "$ASSETS" ] || die "vendored assets missing: $ASSETS" \
  "this looks like an incomplete clone of speckit-pipeline"

if [ -z "$TARGET" ]; then
  TARGET=$(git rev-parse --show-toplevel 2>/dev/null) || \
    die "not inside a git repository" "pass a path: spec-bootstrap /path/to/repo"
fi
[ -d "$TARGET" ] || die "no such directory: $TARGET"
TARGET=$(cd -- "$TARGET" && pwd)

git -C "$TARGET" rev-parse --is-inside-work-tree >/dev/null 2>&1 || \
  die "not a git repository: $TARGET" \
      "spec-kit names feature branches, so run: git -C $TARGET init"

installed=0; skipped=0; drifted=0

# Never ours to write, even under --force. The same list spec-upgrade's
# _is_sacred() carries, and it is stated here rather than inferred: overrides/ is
# spec-upgrade's own mechanism for preserving a customised template, so the two
# tools disagreeing about it means one of them destroys the other's work.
_is_sacred() { # _is_sacred <rel_in_project>
  case "$1" in
    .specify/memory/*|.specify/feature.json|.specify/templates/overrides/*) return 0;;
    .specify/integration.json) return 0;;
    *) return 1;;
  esac
}

# copy_asset <src_file> <dst_file>
#
# ONE FILE. Never a directory — that distinction is the whole of issue #5.
# This took whole directories and, under --force, did `rm -rf "$dst"` before
# recopying, so every path the bundle does not ship was collateral. Reported:
# `spec-bootstrap --force` deleted the five `.specify/templates/overrides/`
# files that `spec-upgrade` had just written to protect the project's customised
# templates, plus two project-side extension scripts from an older scaffold.
# --force's own help text says "replace vendored files that already exist and
# differ", which is per-file and is now what it does.
copy_asset() {
  local src="$1" dst="$2"
  local rel="${dst#"$TARGET"/}"
  _is_sacred "$rel" && { skipped=$((skipped + 1)); return 0; }
  mkdir -p "$(dirname "$dst")"
  # A directory where the bundle ships a file: `cp` would copy INTO it and the
  # project would end up with neither the old path nor the new one.
  if [ -d "$dst" ]; then
    warn "a directory sits where the vendored copy is a file: $rel"
    drifted=$((drifted + 1)); return 0
  fi
  if [ ! -e "$dst" ]; then
    cp "$src" "$dst"; installed=$((installed + 1)); return 0
  fi
  if cmp -s "$src" "$dst"; then
    skipped=$((skipped + 1)); return 0
  fi
  if [ "$FORCE" -eq 1 ]; then
    cp "$src" "$dst"; installed=$((installed + 1))
  else
    warn "differs from the vendored copy: $rel"
    drifted=$((drifted + 1))
  fi
}

# copy_tree <src_dir> <dst_dir> — every file the bundle ships under src_dir, and
# nothing else. Walking files is what keeps --force from touching paths that are
# not ours; it is the same shape as spec-upgrade's classify() loop, deliberately.
copy_tree() {
  local src="$1" dst="$2" f
  [ -d "$src" ] || return 0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    copy_asset "$f" "$dst/${f#"$src"/}"
  done < <(find "$src" -type f 2>/dev/null)
}

info "bootstrapping $TARGET"

# ---- phase skills
copy_tree "$ASSETS/claude-skills" "$TARGET/.claude/skills"

# ---- .specify scaffold
copy_tree "$ASSETS/specify/scripts"    "$TARGET/.specify/scripts"
copy_tree "$ASSETS/specify/templates"  "$TARGET/.specify/templates"
copy_tree "$ASSETS/specify/extensions" "$TARGET/.specify/extensions"
# workflows/ was missing here while spec-upgrade classified it like any other
# scaffold directory, so a bootstrapped project was born one directory short of
# what an upgraded one has: `spec-upgrade` reported workflow.yml and
# workflow-registry.json as `new` forever, and `spec-bootstrap --force` could
# not put them back because nothing here looked for them (issue #6).
copy_tree "$ASSETS/specify/workflows"  "$TARGET/.specify/workflows"
# integrations/ is the same story: upstream's own install manifests, listing what
# `specify init` wrote and the hash of each file. Nothing in THIS pipeline reads
# them, which is exactly why they went missing here and were never noticed —
# spec-upgrade installed them, bootstrap did not, and the divergence only showed
# up as two files eternally reported `new`. The invariant worth holding is that a
# bootstrapped project and an upgraded one are the same project.
copy_tree "$ASSETS/specify/integrations" "$TARGET/.specify/integrations"
copy_asset "$ASSETS/specify/extensions.yml" "$TARGET/.specify/extensions.yml"
[ -f "$ASSETS/specify/init-options.json" ] && \
  copy_asset "$ASSETS/specify/init-options.json" "$TARGET/.specify/init-options.json"

chmod +x "$TARGET"/.specify/scripts/bash/*.sh 2>/dev/null || true
chmod +x "$TARGET"/.specify/extensions/git/scripts/bash/*.sh 2>/dev/null || true

# ---- integration marker
if [ ! -f "$TARGET/.specify/integration.json" ]; then
  printf '{\n  "integration": "claude",\n  "version": "%s"\n}\n' \
    "$(jqd "$SPECKIT_PIPELINE_ROOT/.claude-plugin/plugin.json" \
        '.metadata.speckit_version' 0.7.3)" > "$TARGET/.specify/integration.json"
  installed=$((installed + 1))
fi

# ---- the constitution is the project's, not ours
CONST="$TARGET/.specify/memory/constitution.md"
if [ ! -f "$CONST" ]; then
  mkdir -p "$(dirname "$CONST")"
  cp "$ASSETS/specify/templates/constitution-template.md" "$CONST"
  installed=$((installed + 1))
  CONST_IS_TEMPLATE=1
else
  CONST_IS_TEMPLATE=0
fi

mkdir -p "$TARGET/specs"

# Generated run state, not source. Added rather than merely suggested: the
# roadmap runner writes into the repository and then has to decide whether the
# tree is clean, and an untracked state file is one more thing for a reader to
# wonder about. Idempotent, and it never rewrites an existing entry.
#
# `.specify/feature.json` is the third for a sharper reason than tidiness: it is
# spec-kit's pointer to the feature currently being worked, rewritten by every
# `create-new-feature` and read by the phases after it. On a roadmap, where each
# entry is its own branch, tracking it means every branch carries a different
# value for the same line and every merge conflicts on it — over a file that
# only ever describes the checkout it sits in.
GI="$TARGET/.gitignore"
for pat in 'specs/*/.pipeline/' '.specify/roadmaps/*.state.json' '.specify/feature.json'; do
  if [ ! -f "$GI" ] || ! grep -qxF "$pat" "$GI" 2>/dev/null; then
    [ -f "$GI" ] && [ -s "$GI" ] && [ "$(tail -c1 "$GI" | wc -l)" -eq 0 ] && printf '\n' >> "$GI"
    printf '%s\n' "$pat" >> "$GI"
    installed=$((installed + 1))
  fi
done

say ""
ok "$installed installed, $skipped already current${drifted:+, $drifted differing}"
if [ "${drifted:-0}" -gt 0 ]; then
  warn "re-run with --force to replace the differing files"
  say  "  a difference is not necessarily wrong: a project may have deliberately"
  say  "  customised a template. Look before you force."
fi

# ---- a formatter that rewrites the scaffold makes drift permanent
#
# spec-upgrade compares BYTES (`cmp -s`), which is the honest comparison and the
# one that cannot be talked out of a real difference. The cost is that a commit
# hook reformatting the vendored files is indistinguishable from a project
# customising them. Reported: `prettier --write` over `*.{md,json,yml,yaml}` via
# lint-staged rewrote 30 of the 35 scaffold files immediately after a clean
# upgrade, so every later `spec-upgrade --check` read `30 file(s) differ` — and
# the next `spec-upgrade` would have counted the templates as customised (2
# commits each) and filed pure formatting noise into overrides/ as if it were
# the user's intent (issue #6).
#
# Printed, not written. .prettierignore is the project's file and its formatter
# is the project's decision; the same reasoning that stops spec-upgrade creating
# a .gitignore that is not there. What this owes the reader is the diagnosis
# BEFORE the drift shows up, not a config edit they did not ask for.
_fmt=""
for f in .prettierrc .prettierrc.json .prettierrc.yml .prettierrc.yaml \
         .prettierrc.js .prettierrc.cjs .prettierrc.mjs .prettierrc.toml \
         prettier.config.js prettier.config.cjs prettier.config.mjs \
         .lintstagedrc .lintstagedrc.json .lintstagedrc.js lint-staged.config.js; do
  [ -e "$TARGET/$f" ] && { _fmt="$f"; break; }
done
if [ -z "$_fmt" ] && [ -f "$TARGET/package.json" ]; then
  grep -qE '"(prettier|lint-staged)"[[:space:]]*:' "$TARGET/package.json" 2>/dev/null && \
    _fmt="package.json"
fi
if [ -n "$_fmt" ] && ! grep -qE '^[[:space:]]*\.specify' "$TARGET/.prettierignore" 2>/dev/null; then
  say ""
  warn "this project runs a formatter ($_fmt), and the scaffold is compared byte-for-byte"
  say  "  A hook that reformats the vendored files makes 'spec-upgrade --check' report"
  say  "  drift permanently, and invites the next upgrade to file that reformatting into"
  say  "  .specify/templates/overrides/ as if you had customised the templates."
  say  ""
  say  "  If that formatter can touch markdown, JSON or YAML, exclude the scaffold:"
  say  ""
  say  "      # .prettierignore"
  say  "      .specify"
  say  "      .claude/skills/speckit-*"
  say  ""
  say  "  Not written for you — .prettierignore is yours."
fi

say ""
say "next:"
if [ "$CONST_IS_TEMPLATE" -eq 1 ]; then
  say "  1. fill in .specify/memory/constitution.md — it is a TEMPLATE right now,"
  say "     and every phase reads it. An unfilled constitution is not a neutral"
  say "     default; it is placeholder text shaping every artifact."
  say "     (or run: claude \"/speckit-constitution\")"
  say "  2. $SPECKIT_PIPELINE_ROOT/bin/spec-run \"<what you want built>\""
else
  say "  $SPECKIT_PIPELINE_ROOT/bin/spec-run \"<what you want built>\""
fi
say ""
say "run state and per-phase costs are written to specs/<feature>/.pipeline/,"
say "and roadmap progress to .specify/roadmaps/<slug>.state.json. Both are"
say "already in .gitignore."
say ""
