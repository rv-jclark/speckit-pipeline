#!/usr/bin/env bash
#
# spec-roadmap — plan and execute a series of specs that must ship in order.
#
# A roadmap is one authored JSON file listing entries. `run` takes each entry
# through the full spec-run pipeline, then STOPS: the entry's work has to be
# reviewed and merged before the next entry starts, because the next entry plans
# against the code the previous one landed. Merging is yours — no phase here can
# do it, and this runner cannot either.
#
# Exit codes:  0 the roadmap is complete
#              1 an entry failed, or a prerequisite is missing
#              2 waiting on you — a merge, a gate, or a question
#              3 usage error

set -uo pipefail

SPECKIT_PIPELINE_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export SPECKIT_PIPELINE_ROOT
# shellcheck source=../lib/common.sh
. "$SPECKIT_PIPELINE_ROOT/lib/common.sh"
# shellcheck source=../lib/roadmap.sh
. "$SPECKIT_PIPELINE_ROOT/lib/roadmap.sh"

SPEC_RUN="$SPECKIT_PIPELINE_ROOT/bin/spec-run"

usage() {
  cat <<'EOF'
spec-roadmap — plan and execute a series of specs that must ship in order

USAGE
  spec-roadmap plan  "<the larger goal>" [--slug <name>]   decompose into entries
  spec-roadmap show  [slug]                                 status of every entry
  spec-roadmap run   [slug]                                 run the next entry
  spec-roadmap list                                         roadmaps in this repo

OPTIONS
  --repo <path>       repository root (default: git toplevel of cwd)
  --base <ref>        branch entries are cut from and merged into. Detected from
                      origin/HEAD, then the remotes, then local main/master/trunk
                      — the run prints which, so a wrong guess is visible
  --slug <name>       roadmap name; with `plan`, names the new file
  --budget <usd>      ceiling for THIS run; overrides `budget_usd` in the roadmap
                      file. Checked before each entry starts, so it bounds how
                      many entries run rather than what one entry spends — the
                      per-phase ceilings do that
  --dry-run           print what would happen, run nothing
  --model <p>=<m>     passed through to spec-run  (repeatable)
  --effort <p>=<e>    passed through to spec-run  (repeatable)
  --stop-after <p>    passed through to spec-run
  --with <p[,p]>      passed through to spec-run
  --add-dir <path>    passed through to spec-run (repeatable)
  --stream            passed through to spec-run: show each phase's steps live
  --from-doc <path>   with `plan`: read an EXISTING roadmap document and turn the
                      sequence its author already decided into entries, instead of
                      decomposing a goal from scratch
  --version              print the version and where this copy is installed
  -h, --help

HOW IT RUNS
  Each entry goes through specify → plan → tasks → implement, then the roadmap
  stops and hands you the branch. You review and merge; `spec-roadmap run` picks
  up the next entry from the updated base. An entry is treated as landed when its
  branch is an ancestor of the base OR its tasks.md is present there — the second
  check is what makes this work in a repository that squash-merges, where a
  merged branch is never an ancestor of anything.
EOF
}

# ------------------------------------------------------------------ args ------
CMD="${1:-}"; [ $# -gt 0 ] && shift
case "$CMD" in
  plan|show|run|list) ;;
  -h|--help|"") usage; exit 0;;
  --version) pipeline_version; exit 0;;
  *) err "unknown command: $CMD"; usage >&2; exit 3;;
esac

REPO=""; BASE=""; BASE_HOW=""; SLUG=""; GOAL=""; BUDGET=""; DRY_RUN=0; FROM_DOC=""
declare -a ADD_DIRS=()
declare -a PASSTHROUGH=()
while [ $# -gt 0 ]; do
  case "$1" in
    --repo)        REPO="${2:-}"; shift 2 || exit 3;;
    --base)        BASE="${2:-}"; shift 2 || exit 3;;
    --slug)        SLUG="${2:-}"; shift 2 || exit 3;;
    --from-doc)    FROM_DOC="${2:-}"; shift 2 || exit 3;;
    --budget)      BUDGET="${2:-}"; shift 2 || exit 3;;
    --dry-run)     DRY_RUN=1; shift;;
    --model|--effort)      PASSTHROUGH+=("$1" "${2:-}"); shift 2 || exit 3;;
    --add-dir)             PASSTHROUGH+=("$1" "${2:-}"); ADD_DIRS+=("${2:-}"); shift 2 || exit 3;;
    --stop-after|--with)   PASSTHROUGH+=("$1" "${2:-}"); shift 2 || exit 3;;
    --stream|--no-stream)  PASSTHROUGH+=("$1"); shift;;
    -h|--help)     usage; exit 0;;
    --version)     pipeline_version "${REPO:-}"; exit 0;;
    -*)            err "unknown option: $1"; exit 3;;
    *)             GOAL="${GOAL:+$GOAL }$1"; shift;;
  esac
done

if [ -z "$REPO" ]; then
  REPO=$(git rev-parse --show-toplevel 2>/dev/null) || \
    die "not inside a git repository" "pass --repo <path>"
fi
REPO=$(cd -- "$REPO" && pwd)
preflight "$REPO" || exit 1

# An explicit --base wins; otherwise detect, and say how.
if [ -z "$BASE" ]; then
  IFS=$'\t' read -r BASE BASE_HOW < <(detect_base "$REPO")
  [ -n "$BASE" ] || die "could not work out which branch to use as the base" \
    "pass --base <ref>"
fi

RMDIR=$(roadmap_dir "$REPO")

if [ -n "$SLUG" ] && ! valid_slug "$SLUG"; then
  die_usage "not a usable roadmap name: $SLUG" \
    "lower-case letters, digits, dot, dash and underscore; must start with a letter or digit"
fi

# `show`/`run` with no slug: if there is exactly one roadmap, use it; if there
# are several, say which rather than picking.
resolve_slug() {
  [ -n "$SLUG" ] && return 0
  local -a found=()
  local f
  for f in "$RMDIR"/*.json; do
    [ -f "$f" ] || continue
    case "$f" in *.state.json) continue;; esac
    found+=("$(basename "${f%.json}")")
  done
  case "${#found[@]}" in
    0) die "no roadmaps in ${RMDIR#"$REPO"/}" \
           "create one: spec-roadmap plan \"<the larger goal>\"";;
    1) SLUG="${found[0]}";;
    *) die "several roadmaps here; name one with --slug" \
           "$(printf '%s ' "${found[@]}")";;
  esac
}

# ------------------------------------------------------------------ list ------
if [ "$CMD" = list ]; then
  n=0
  for f in "$RMDIR"/*.json; do
    [ -f "$f" ] || continue
    case "$f" in *.state.json) continue;; esac
    slug=$(basename "${f%.json}")
    total=$(jq -r '(.entries // []) | length' "$f" 2>/dev/null || echo '?')
    st=$(roadmap_state "$REPO" "$slug")
    donen=$( [ -f "$st" ] && jq -r '[.entries[] | select(.status=="done")] | length' "$st" || echo 0 )
    printf '  %-28s %s/%s done\n' "$slug" "$donen" "$total"
    n=$((n+1))
  done
  [ "$n" -eq 0 ] && say "  no roadmaps in ${RMDIR#"$REPO"/}"
  exit 0
fi

# ------------------------------------------------------------------ plan ------
if [ "$CMD" = plan ]; then
  if [ -n "$FROM_DOC" ]; then
    [ -f "$FROM_DOC" ] || die_usage "no such roadmap document: $FROM_DOC"
    FROM_DOC=$(cd -- "$(dirname -- "$FROM_DOC")" && pwd)/$(basename -- "$FROM_DOC")
    # The doc must be inside the repo, because the specify phase will be told to
    # read it and a phase cannot read what is not there.
    case "$FROM_DOC" in
      "$REPO"/*) ;;
      *) die_usage "the roadmap document is outside the repository" \
           "the specify phase reads it from the repo, so it has to live in $REPO";;
    esac
  else
    [ -n "$GOAL" ] || die "no goal given" \
      "spec-roadmap plan \"the larger thing you want built\"   (or --from-doc <path>)"
  fi
  if [ -z "$SLUG" ]; then
    if [ -n "$FROM_DOC" ]; then
      # A doc has a name already; using it keeps the roadmap and the document that
      # defines it findable from each other.
      # Named after the document, exactly. An earlier version tried to strip a
      # "-roadmap" suffix and could not: `tr` turns basename's trailing newline
      # into a dash, so the string ended "-roadmap-" and the anchored substitution
      # never matched. Matching the doc name is also just more predictable.
      SLUG=$(basename "$FROM_DOC" .md | tr '[:upper:]' '[:lower:]' |
             tr -cs 'a-z0-9' '-' | sed 's/-*$//;s/^-*//' | cut -c1-40)
    else
      SLUG=$(printf '%s' "$GOAL" | tr '[:upper:]' '[:lower:]' |
             tr -cs 'a-z0-9' '-' | cut -c1-40 | sed 's/^-//;s/-$//')
    fi
    # A goal made entirely of punctuation derives to nothing, and an empty slug
    # would name the file ".json".
    valid_slug "$SLUG" || die_usage "could not derive a roadmap name" \
      "pass one: spec-roadmap plan --slug <name> ..."
  fi
  RM=$(roadmap_file "$REPO" "$SLUG")
  [ -e "$RM" ] && die "a roadmap already exists at ${RM#"$REPO"/}" \
    "read it with: spec-roadmap show $SLUG   (or choose another --slug)"
  mkdir -p "$RMDIR"

  model=$(jqd "$SPECKIT_PIPELINE_ROOT/lib/phases.json" '.phases[0].model' opus)
  effort=$(jqd "$SPECKIT_PIPELINE_ROOT/lib/phases.json" '.phases[0].effort' high)
  bin="${SPEC_RUN_CLAUDE_BIN:-$(jqd "$SPECKIT_PIPELINE_ROOT/lib/phases.json" '.defaults.claude_bin' claude)}"

  if [ -n "$FROM_DOC" ]; then
    doc_rel=${FROM_DOC#"$REPO"/}
    prompt=$(cat <<EOF
Read the roadmap document at $doc_rel and TRANSCRIBE the spec sequence its author
already decided into $RM as JSON.

You are not designing the split. A human designed it, in that document, with
reasons. Your job is to make it machine-readable without changing it.

Rules, in order of importance:

1. ONE ENTRY PER SPEC IN THE DOCUMENT, in the document's order. Do not merge two,
   do not split one, do not add one the author did not write, do not drop one you
   think is unnecessary. If the document numbers them, keep that numbering in the
   titles so the two can be read side by side.
2. Each "description" is what a later process hands VERBATIM to the specify phase,
   and that phase will not have read the rest of the document. So each one must
   carry, in its own words:
     * what the entry itself says, including any testing requirements the author
       attached to it;
     * an instruction to read $doc_rel in full before specifying — naming the
       sections that constrain it (decisions, constraints, data model, lessons, or
       whatever that document actually calls them);
     * what the entry must NOT take on, naming the later entry that owns it, where
       the author says so.
   Inline the substance and point at the document for the rest. A description that
   only says "implement step 3" is useless; one that reproduces 300 lines is worse.
3. "rationale" is the author's reason for the position, if they gave one. If they
   did not, say so plainly rather than inventing one.
4. Where the document contradicts itself, or an entry has no clear boundary,
   say so in your final message instead of choosing for the author.

Write exactly this shape:

{
  "goal": "<the document's own one-sentence framing>",
  "base": "$BASE",
  "source_doc": "$doc_rel",
  "budget_usd": null,
  "entries": [
    { "slug": "short-kebab-name", "title": "...", "description": "...", "rationale": "..." }
  ]
}

Write the file, then say how many entries you transcribed and list their slugs, so
a human can check the count against the document. Do not create branches, do not
run any other phase, and do not begin implementing anything.

Finish your final message with:
STATUS: ok | needs_input | failed — <one sentence>
EOF
)
  else
    prompt=$(cat <<EOF
Decompose this into an ORDERED series of specs, and write the result to
$RM as JSON.

The goal: $GOAL

Read the repository first — its code, its CLAUDE.md or README, and
.specify/memory/constitution.md — so the split follows what is actually here
rather than a generic template.

Write exactly this shape:

{
  "goal": "<the goal, in one sentence>",
  "base": "$BASE",
  "entries": [
    {
      "slug": "short-kebab-name",
      "title": "One line a human reads in a status table",
      "description": "The feature description handed verbatim to the specify phase. Write it as though briefing someone who will implement only this entry: what it must do, and what it must NOT take on because a later entry owns it.",
      "rationale": "Why this entry comes here rather than earlier or later — what it depends on from the entries before it."
    }
  ]
}

Rules for the split, which matter more than the JSON:

1. Every entry must be SHIPPABLE ON ITS OWN. Each becomes its own branch and its
   own pull request, merged before the next entry starts. An entry that leaves
   the repository broken until a later entry lands is a wrong split.
2. Order by real dependency, and say what it is in "rationale". If two entries do
   not depend on each other, the earlier one should be the one that reduces the
   most uncertainty for the rest.
3. Prefer FEWER, larger entries. Each entry costs a full pipeline and a human
   review cycle, so splitting for neatness is expensive. Two to six is the useful
   range; if you find yourself writing eight, the split is probably by code layer
   rather than by shippable outcome.
4. Do not carve work out to make an entry smaller. Anything needed to make an
   entry correct belongs in that entry.
5. Say in each description what the entry does NOT do, naming the entry that
   picks it up. That boundary is the thing the specify phase most often gets
   wrong when it cannot see the roadmap.

Write the file, then confirm what you wrote. Do not create branches, do not run
any other phase, and do not begin implementing anything.

Finish your final message with:
STATUS: ok | needs_input | failed — <one sentence>
EOF
)
  fi

  if [ -n "$FROM_DOC" ]; then
    info "transcribing ${FROM_DOC#"$REPO"/} into roadmap '$SLUG' — $model/$effort"
  else
    info "planning roadmap '$SLUG' — $model/$effort"
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    say "  would write: ${RM#"$REPO"/}"
    printf '  %s -p <decomposition prompt> --model %s --effort %s\n' "$bin" "$model" "$effort"
    exit 0
  fi

  declare -a plan_extra=()
  if [ "${#ADD_DIRS[@]}" -gt 0 ]; then
    for _ad in "${ADD_DIRS[@]}"; do [ -n "$_ad" ] && plan_extra+=(--add-dir "$_ad"); done
  fi
  errf=$(mktmp)
  out=$( cd "$REPO" && "$bin" -p "$prompt" --model "$model" --effort "$effort" \
           --output-format json --permission-mode acceptEdits \
           --session-id "$(new_uuid)" "${plan_extra[@]+"${plan_extra[@]}"}" \
           --disallowed-tools "Bash(git push:*),Bash(gh pr merge:*),Bash(git checkout:*),Bash(git commit:*)" \
           2>"$errf" ); rc=$?
  json=$(extract_json "$out") || json=""
  cost=$( [ -n "$json" ] && jq -r '.total_cost_usd // empty' <<<"$json" || echo "" )

  if [ ! -f "$RM" ]; then
    err "the planning phase did not write ${RM#"$REPO"/} (exit $rc, $(fmt_cost "$cost"))"
    [ -n "$json" ] && dim "  $(jq -r '.result // empty' <<<"$json" | head -5)"
    [ -s "$errf" ] && dim "  stderr: $(head -c 400 "$errf")"
    rm -f "$errf"; exit 1
  fi
  rm -f "$errf"

  if ! reason=$(roadmap_validate "$RM"); then
    err "the roadmap it wrote is not usable: $reason"
    say "  left in place for you to fix: ${RM#"$REPO"/}"
    exit 1
  fi
  ok "wrote ${RM#"$REPO"/} — $(jq -r '(.entries|length)' "$RM") entries ($(fmt_cost "$cost"))"
  say ""
  say "read it:  spec-roadmap show $SLUG"
  say "start it: spec-roadmap run $SLUG"
  say ""
  exit 0
fi

# ------------------------------------------------------------------ show ------
resolve_slug
RM=$(roadmap_file "$REPO" "$SLUG")
if ! reason=$(roadmap_validate "$RM"); then die "$reason"; fi
ST=$(roadmap_state "$REPO" "$SLUG")
BASE=$(jqd "$RM" '.base' "$BASE")
# A ceiling passed only on the command line is one somebody forgets, and a
# forgotten ceiling is silently unlimited — the shape this tool is meant to
# dislike. So the roadmap file may declare `budget_usd`; --budget overrides it
# for a single run.
[ -z "$BUDGET" ] && BUDGET=$(jqd "$RM" '.budget_usd' "")
roadmap_state_init "$ST" "${RM#"$REPO"/}" "$SLUG" "$BASE"

if [ "$CMD" = show ]; then
  say ""
  say "roadmap  $(dim_s "$SLUG")   base $(dim_s "$BASE")"
  [ -n "$BASE_HOW" ] && dim "         base chosen because: $BASE_HOW"
  say "goal     $(jq -r '.goal // "(none stated)"' "$RM")"
  _doc=$(roadmap_source_doc "$RM")
  if [ -n "$_doc" ]; then
    if [ -f "$REPO/$_doc" ]; then
      say "doc      $(dim_s "$_doc")"
    else
      say "doc      $_doc"
      warn "that document is missing; each entry's description tells its phase to read it"
    fi
  fi
  say ""
  roadmap_fetch_base "$REPO" "$BASE"; fresh=$?
  [ "$fresh" -ne 0 ] && warn "could not fetch $BASE — landed/not-landed below may be stale"
  i=0
  while IFS=$'\t' read -r slug title; do
    i=$((i+1))
    status=$(roadmap_entry_get "$ST" "$slug" status pending)
    fdir=$(roadmap_entry_get "$ST" "$slug" feature_dir "")
    branch=$(roadmap_entry_get "$ST" "$slug" branch "")
    IFS=$'\t' read -r landed how < <(entry_landed "$REPO" "$BASE" "$fdir" "$branch" "$fresh" "$slug")
    [ "$landed" = "done" ] && status="done"
    case "$status" in
      done)           mark="✓";;
      awaiting_merge) mark="⏸";;
      blocked)        mark="✗";;
      in_progress)    mark="▸";;
      *)              mark="·";;
    esac
    printf '  %s %-2s %-26s %-15s %s\n' "$mark" "$i" "$slug" "$status" "$title"
    [ "$status" = awaiting_merge ] && dim "        $how"
    [ "$status" = blocked ] && dim "        $(roadmap_entry_get "$ST" "$slug" note "")"
  done < <(jq -r '.entries[] | [.slug, .title // ""] | @tsv' "$RM")
  say ""
  total=$(jq -r '.entries|length' "$RM")
  donen=$(jq -r '[.entries[] | select(.status=="done")] | length' "$ST")
  spent=$(roadmap_spent "$REPO" "$ST")
  say "  $donen of $total landed$( [ "$spent" != "0" ] && printf ', $%s spent' "$spent")"
  say ""
  exit 0
fi

# ------------------------------------------------------------------- run ------
say ""
say "roadmap  $(dim_s "$SLUG")   base $(dim_s "$BASE")"
[ -n "$BASE_HOW" ] && dim "         base chosen because: $BASE_HOW"

# Checked here, before any phase is billed, for the reason in roadmap_source_doc:
# the descriptions are what point a phase at this file, so a stale path is a
# defect in every remaining entry at once rather than in one of them.
SOURCE_DOC=$(roadmap_source_doc "$RM")
if [ -n "$SOURCE_DOC" ] && [ ! -f "$REPO/$SOURCE_DOC" ]; then
  warn "source_doc does not resolve: $SOURCE_DOC"
  say  "  The entries' descriptions tell each phase to read it before specifying,"
  say  "  so every phase from here on is pointed at a file that is not there."
  say  "  Fix the path in ${RM#"$REPO"/}, or drop the key if the document is gone."
fi
say ""

roadmap_fetch_base "$REPO" "$BASE"; fresh=$?
[ "$fresh" -ne 0 ] && warn "could not fetch $BASE; working from the ref as last fetched"

# Two roadmaps in one repository share one working tree and one current-feature
# pointer. Nothing here breaks — each entry gets its own feature — but an entry
# left mid-flight by ANOTHER roadmap is worth saying out loud, because its
# uncommitted work will follow this checkout and land in this entry's diff.
for other in "$RMDIR"/*.state.json; do
  [ -f "$other" ] || continue
  case "$other" in *"/$SLUG.state.json") continue;; esac
  inflight=$(jq -r '[.entries | to_entries[]
                     | select(.value.status=="in_progress" or .value.status=="awaiting_merge")
                     | .key] | join(", ")' "$other" 2>/dev/null)
  if [ -n "$inflight" ]; then
    warn "another roadmap ($(basename "${other%.state.json}")) has entries in flight: $inflight"
    say  "  They share this working tree. Finish or merge those first if their work"
    say  "  should not appear in this entry's diff."
  fi
done

rc_final=0
# By index, for the same reason spec-run iterates by index: the loop body runs
# spec-run, which runs a process that reads stdin, and a stream-fed loop hands it
# the remaining entries to eat.
n_entries=$(jq -r '.entries | length' "$RM")
ei=0
while [ "$ei" -lt "$n_entries" ]; do
  # One jq call per field, deliberately, and NOT one `read` over a separated
  # line. Two hazards, and a single read cannot avoid both:
  #
  #   * FIELD COLLAPSE. `title` is the MIDDLE field, so an entry authored without
  #     one shifts the DESCRIPTION into the title slot and leaves the description
  #     empty — the phase would be handed no description at all. The roadmap file
  #     is documented as "a plain authored file", so an omitted title is a thing a
  #     user can do. A \037 separator fixes this one.
  #   * TRUNCATION AT THE FIRST NEWLINE. `read` reads a LINE. A description is
  #     documented as handed VERBATIM to the specify phase, and `plan --from-doc`
  #     explicitly tells the planner to inline the entry's substance, name the
  #     document sections that constrain it, and say what it must not take on —
  #     which is several paragraphs, not one line. Measured on a real 7-entry
  #     roadmap: descriptions of 3,000–5,000 characters over 13–22 lines each
  #     arrived at spec-run as their FIRST LINE, losing every scope boundary and
  #     every "do not take this on, entry N owns it". Nothing warned; --dry-run
  #     printed the truncated string and looked plausible.
  #
  # Command substitution strips only TRAILING newlines, so internal structure
  # survives. Three parses of a small file is not a cost worth a subtle read.
  slug=$(jq -r ".entries[$ei].slug" "$RM")
  title=$(jq -r ".entries[$ei].title // \"\"" "$RM")
  description=$(jq -r ".entries[$ei].description" "$RM")
  ei=$((ei + 1))
  status=$(roadmap_entry_get "$ST" "$slug" status pending)
  fdir=$(roadmap_entry_get "$ST" "$slug" feature_dir "")
  branch=$(roadmap_entry_get "$ST" "$slug" branch "")

  IFS=$'\t' read -r landed how < <(entry_landed "$REPO" "$BASE" "$fdir" "$branch" "$fresh" "$slug")

  if [ "$landed" = "done" ]; then
    [ "$status" != "done" ] && roadmap_entry_set "$ST" "$slug" '{"status":"done"}'
    ok "$slug — landed on $BASE"
    dim "    $how"
    continue
  fi

  # The gate. An entry that ran but has not landed stops the roadmap here, and an
  # UNKNOWN answer stops it too rather than guessing — "not merged yet" and "I
  # could not tell" have different remedies, and only one of them is waiting.
  # An UNKNOWN answer stops the roadmap whatever the entry's status, rather than
  # guessing — "not merged yet" and "I could not tell" have different remedies,
  # and only one of them is waiting on a human.
  # Scoped to entries that have actually RUN. Broadening this to "any non-pending
  # status" looked equivalent and was not: a `done` entry with no branch recorded
  # answers `unknown` too, so the wider form stopped the roadmap before the
  # budget check and took five budget assertions down with it.
  if [ "$landed" = unknown ] && { [ "$status" = awaiting_merge ] || [ "$status" = blocked ]; }; then
    warn "$slug — cannot tell whether this has landed"
    say "    $how"
    say ""
    say "  Not treated as unmerged: that would start the next entry against a"
    say "  base that may already contain this one. Resolve the cause and re-run."
    say ""
    exit 2
  fi

  # The merge gate. This is for an entry whose pipeline FINISHED and now needs a
  # human to merge it — the one thing no phase here is given the tools to do.
  if [ "$status" = awaiting_merge ]; then
    warn "$slug — waiting on you"
    say ""
    say "  This entry's pipeline is finished; its work is not on $BASE yet."
    say "    $how"
    [ -n "$branch" ] && say "  branch: $branch"
    [ -n "$fdir" ]   && say "  specs:  $fdir"
    say ""
    say "  Review and merge it, then: spec-roadmap run $SLUG"
    say "  (merging is yours — no phase here is given the tools to do it)"
    say ""
    exit 2
  fi

  # 🛑 `blocked` used to share the gate above, which was wrong twice over. It
  # printed "this entry's pipeline is finished — review and merge it" about an
  # entry whose pipeline had FAILED, so the remedy named was the opposite of the
  # one needed; and because the gate always exited 2, a blocked entry could
  # never be retried at all without hand-editing the state file. The status and
  # its recorded `note` were both already on hand and both discarded.
  #
  # A blocked entry is RETRIED, because that is what the artifact-as-authority
  # model already supports: spec-run skips the phases whose artifacts are good
  # and re-runs the one that failed. `run` takes one entry and stops, so a human
  # is invoking each attempt — there is no loop to guard against.
  if [ "$status" = blocked ]; then
    note=$(roadmap_entry_get "$ST" "$slug" note "")
    warn "$slug — retrying an entry that failed"
    [ -n "$note" ] && say "    previously: $note"
    say "    completed phases are kept; only what failed re-runs"
    say ""
  fi

  if [ "$landed" = unknown ] && [ "$status" = pending ]; then
    : # a pending entry has nothing to have landed; unknown is expected here
  fi

  # ---- run this entry
  info "$slug — $title"

  # An entry that has already RUN has a feature. Handing spec-run the description
  # again makes spec-kit cut a second feature branch for the same roadmap entry —
  # two specs, two branches, one entry, and a state file that can only point at
  # one of them. So resume the feature that exists.
  #
  # Reached by anything that interrupts a run: Ctrl-C, a rolling restart, a
  # deleted state file, a laptop closing.
  #
  # 🛑 `blocked` belongs here as much as `in_progress`, and testing only the
  # latter is what made the retry path above useless in practice: a blocked entry
  # WITH a recorded feature_dir went down the create path and refused with
  # "cannot cut this entry from main", because the base is not an ancestor of the
  # branch the feature already sits on. A failed entry is the likeliest one to be
  # retried, so it is the likeliest one to need its existing feature.
  resume_dir=""
  if [ "$status" = in_progress ] || [ "$status" = blocked ]; then
    if [ -n "$fdir" ] && [ -d "$REPO/$fdir" ]; then
      resume_dir="$fdir"
    else
      probe=$(jq -r '.feature_directory // empty' "$REPO/.specify/feature.json" 2>/dev/null)
      [ -n "$probe" ] && [ -d "$REPO/$probe" ] && resume_dir="$probe"
    fi
    if [ -n "$resume_dir" ]; then
      dim "    resuming its existing feature: $resume_dir"
    else
      # Naming the status it actually holds, since `blocked` reaches here too and
      # "recorded as in progress" would be a false statement about the state.
      warn "    recorded as $status, but no feature directory was found —"
      warn "    starting this entry from the beginning"
    fi
  fi

  # These checks guard a BRANCH SWITCH, so they belong to a new entry only. A
  # resumed entry stays on its own branch and its half-finished work is expected
  # to be sitting there uncommitted — refusing over it would block resume in
  # exactly the situation resume exists for, an interruption partway through
  # implementation.
  #
  # And they run BEFORE the dry run, not after: a dry run that reports
  # "would run: …" where the real run refuses is worse than no dry run at all,
  # because the whole point of asking is to find out what will happen. Getting
  # this order wrong is a two-line edit and it silently makes --dry-run lie, so
  # the suite asserts the warning appears under --dry-run specifically.
  if [ -z "$resume_dir" ]; then
    # Switching branches over somebody's uncommitted work is not this tool's call
    # to make, and stashing on their behalf is worse. Tracked modifications refuse;
    # untracked files only warn, because git carries those across a checkout and
    # refuses outright rather than losing one.
    changes=$(tracked_changes "$REPO")
    if [ -n "$changes" ]; then
      err "there are uncommitted tracked changes; not switching branch over them"
      printf '%s\n' "$changes" | head -20 | sed 's/^/    /'
      say ""
      say "  If this is the previous entry's work, commit it and merge it — the"
      say "  roadmap is waiting on exactly that. Otherwise commit or stash it"
      say "  yourself; this will not stash on your behalf."
      say "  Then: spec-roadmap run $SLUG"
      exit 1
    fi
    stray=$(untracked_files "$REPO")
    if [ -n "$stray" ]; then
      warn "untracked files will follow this checkout into the new entry's branch:"
      printf '%s\n' "$stray" | head -10 | sed 's/^/    /'
      n_stray=$(printf '%s\n' "$stray" | grep -c . || true)
      [ "${n_stray:-0}" -gt 10 ] && dim "    … and $((n_stray - 10)) more"
      say "  Not a blocker — git preserves them — but if any belong to the previous"
      say "  entry, commit them there first or they will appear in this entry's diff."
    fi
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    if [ "${#PASSTHROUGH[@]}" -gt 0 ]; then
      printf '    would run: spec-run %s\n' "$(printf '%q ' "${PASSTHROUGH[@]}" "$description")"
    else
      printf '    would run: spec-run %s\n' "$(printf '%q' "$description")"
    fi
    continue
  fi

  # A NEW entry is cut from the base, which by now contains everything the
  # previous entries landed — that is the whole point of the merge gate. A
  # RESUMED entry must stay on its own branch: switching to the base would leave
  # the half-finished work behind and resume against the wrong tree.
  if [ -z "$resume_dir" ]; then
    base_local=${BASE##*/}
    head_branch=$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [ "$head_branch" != "$base_local" ]; then
      if ! git -C "$REPO" checkout --quiet "$base_local" 2>/dev/null; then
        # A branch can only be checked out in ONE worktree, and this workspace's
        # normal flow is several at once — so `git checkout main` inside a worktree
        # fails with "already used by worktree at …". Cutting from the remote ref
        # instead would be worse than failing: it would silently drop whatever this
        # worktree has committed that the base does not have, which here was the
        # scaffold upgrade itself.
        #
        # If the base is already an ancestor of HEAD, this branch contains
        # everything the base does and is the right thing to cut from. Say so, and
        # carry on.
        if git -C "$REPO" merge-base --is-ancestor "$BASE" HEAD 2>/dev/null; then
          say "    $base_local is checked out elsewhere; cutting this entry from"
          say "    $head_branch instead, which already contains $BASE"
        elif git -C "$REPO" checkout --quiet -b "$base_local" --track "$BASE" 2>/dev/null; then
          : # a fresh clone had the remote ref but no local branch of that name
        else
          held=$(git -C "$REPO" worktree list 2>/dev/null | grep "\[$base_local\]" | awk '{print $1}')
          die "cannot cut this entry from $base_local" \
              "${held:+it is checked out at $held, and }$head_branch does not contain $BASE — merge $BASE in, or pass --base $head_branch"
        fi
      fi
    fi
    # Only fast-forward when we are actually ON the base branch; a worktree on its
    # own branch must not be pulled onto the base.
    if [ "$(git -C "$REPO" rev-parse --abbrev-ref HEAD)" = "$base_local" ]; then
      git -C "$REPO" merge --ff-only --quiet "$BASE" 2>/dev/null || \
        warn "could not fast-forward $base_local to $BASE — this entry starts from $base_local as it is"
    fi
  fi

  head_before=$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null)
  roadmap_entry_set "$ST" "$slug" '{"status":"in_progress"}'

  if [ -n "$BUDGET" ]; then
    # ⚠️ This bounds how many ENTRIES start, not what one entry spends: it runs
    # before each entry, and only a phase's own max_budget_usd can stop it
    # mid-flight. The shipped phases set none, so a single entry is bounded by
    # max_turns alone and can overshoot a smaller roadmap budget by any amount.
    # Read this as "stop starting work", never as "do not exceed".
    spent=$(roadmap_spent "$REPO" "$ST")
    if awk -v s="$spent" -v b="$BUDGET" 'BEGIN{exit !(s >= b)}'; then
      err "roadmap budget of \$$BUDGET reached (\$$spent spent) before '$slug'"
      exit 1
    fi
  fi

  # NOT "${PASSTHROUGH[@]:-}": on bash 3.2 an empty array expands that way to a
  # single EMPTY argument, which spec-run then reads as part of the feature
  # description. It survives by luck today (an empty first positional collapses
  # into the description that follows) and would not survive a reordering.
  if [ -n "$resume_dir" ]; then
    # No description: phases already recorded ok are skipped, so this picks up
    # exactly where the interrupted run stopped.
    if [ "${#PASSTHROUGH[@]}" -gt 0 ]; then
      "$SPEC_RUN" --repo "$REPO" --feature-dir "$REPO/$resume_dir" "${PASSTHROUGH[@]}"; src=$?
    else
      "$SPEC_RUN" --repo "$REPO" --feature-dir "$REPO/$resume_dir"; src=$?
    fi
  elif [ "${#PASSTHROUGH[@]}" -gt 0 ]; then
    "$SPEC_RUN" --repo "$REPO" "${PASSTHROUGH[@]}" "$description"; src=$?
  else
    "$SPEC_RUN" --repo "$REPO" "$description"; src=$?
  fi

  # Learn where it landed, and what it cost, from the pipeline's own state.
  newdir=$(jq -r '.feature_directory // empty' "$REPO/.specify/feature.json" 2>/dev/null)
  newbranch=$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null)
  ecost=0
  if [ -n "$newdir" ] && [ -f "$REPO/$newdir/.pipeline/state.json" ]; then
    ecost=$(jq -r '[.phases[].cost_usd // 0] | add // 0' "$REPO/$newdir/.pipeline/state.json")
  fi

  # An entry that never got a branch of its own cannot be reviewed or merged
  # separately, so the merge gate has nothing to gate and the roadmap would march
  # on with its central promise quietly broken. Measured: spec-kit's branch script
  # was denied four times in a worktree, the phase reported success, and the entry
  # stayed on the roadmap branch.
  #
  # Detected by comparing where we ended up against where we started: the branch
  # is the entry's own only if it differs from both.
  entry_has_own_branch=1
  if [ "$src" -eq 0 ]; then
    if [ -z "$newbranch" ] || [ "$newbranch" = "$head_before" ] || \
       [ "$newbranch" = "${BASE##*/}" ]; then
      entry_has_own_branch=0
    fi
  fi

  case "$src" in
    0) if [ "$entry_has_own_branch" -eq 0 ]; then
         roadmap_entry_set "$ST" "$slug" "$(jq -n --arg d "$newdir" --arg b "$newbranch" \
              --arg c "$ecost" --arg n "the pipeline finished but the entry has no branch of its own" \
              '{status:"blocked", feature_dir:$d, branch:$b, note:$n,
                cost_usd:($c|tonumber? // null)}')"
         say ""
         err "$slug — the pipeline finished, but this entry has no branch of its own"
         say "  still on: ${newbranch:-<unknown>}"
         say "  specs:    ${newdir:-<none>}"
         say ""
         say "  Each entry is meant to become its own branch and its own pull request;"
         say "  that is what the merge gate gates. Without one there is nothing to"
         say "  review separately and nothing for the next entry to wait on, so the"
         say "  roadmap stops here rather than continuing with its central promise"
         say "  quietly broken."
         say ""
         say "  Usually this means spec-kit could not create the branch. Check the"
         say "  phase's denied tool calls:"
         say "    jq -r '.parsed.permission_denials[]?.tool_input.command' \\"
         say "      ${newdir:-<feature>}/.pipeline/specify.result.json"
         say ""
         rc_final=1
         break
       fi
       roadmap_entry_set "$ST" "$slug" "$(jq -n --arg d "$newdir" --arg b "$newbranch" \
            --arg c "$ecost" '{status:"awaiting_merge", feature_dir:$d, branch:$b,
                               cost_usd:($c|tonumber? // null)}')"
       say ""
       ok "$slug — pipeline complete"
       say "  branch: $newbranch"
       say "  specs:  $newdir"
       say ""
       say "  Open a pull request, review it, and merge. Then: spec-roadmap run $SLUG"
       say "  The next entry is cut from $BASE, so it plans against your merged code."
       say ""
       exit 2;;
    2) roadmap_entry_set "$ST" "$slug" "$(jq -n --arg d "$newdir" --arg b "$newbranch" \
            --arg c "$ecost" '{status:"in_progress", feature_dir:$d, branch:$b,
                               cost_usd:($c|tonumber? // null)}')"
       say ""
       warn "$slug — the pipeline stopped and needs you (see above)"
       say "  continue that entry: spec-run --resume"
       say "  then the roadmap:    spec-roadmap run $SLUG"
       say ""
       exit 2;;
    *) roadmap_entry_set "$ST" "$slug" "$(jq -n --arg d "$newdir" --arg b "$newbranch" \
            --arg c "$ecost" --arg n "spec-run exited $src" \
            '{status:"blocked", feature_dir:$d, branch:$b, note:$n,
              cost_usd:($c|tonumber? // null)}')"
       err "$slug — the pipeline failed (exit $src); the roadmap stops here"
       rc_final=1
       break;;
  esac
done

if [ "$rc_final" -eq 0 ]; then
  total=$(jq -r '.entries|length' "$RM")
  donen=$(jq -r '[.entries[] | select(.status=="done")] | length' "$ST")
  say ""
  if [ "$donen" -eq "$total" ]; then
    ok "roadmap '$SLUG' complete — all $total entries landed on $BASE"
  else
    ok "$donen of $total entries landed"
  fi
  say ""
fi
exit "$rc_final"
