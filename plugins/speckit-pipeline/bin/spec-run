#!/usr/bin/env bash
#
# spec-run — drive a spec-kit feature through its phases, one isolated
# `claude -p` process per phase, each with its own model, effort, tool
# allowance and spend ceiling.
#
# Why a process per phase rather than one long session:
#   * the model and effort that suit writing a spec do not suit checking off
#     47 mechanical tasks, and only a per-process flag can differ;
#   * a phase's transcript — tool calls, file dumps, test output — dies with
#     its process instead of accumulating in a window you keep paying for;
#   * --max-budget-usd and --max-turns are per-process ceilings, so a phase
#     that goes wrong is bounded by arithmetic rather than by noticing;
#   * --disallowed-tools is enforced by the harness, so "do not merge and
#     deploy" is a missing tool rather than a sentence a model may reinterpret.
#
# Exit codes:  0 every selected phase verified ok
#              1 a phase failed, or a prerequisite is missing
#              2 stopped at a gate, or a phase needs human input
#              3 usage error

set -uo pipefail

SPECKIT_PIPELINE_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export SPECKIT_PIPELINE_ROOT
# shellcheck source=../lib/common.sh
. "$SPECKIT_PIPELINE_ROOT/lib/common.sh"
# shellcheck source=../lib/verify.sh
. "$SPECKIT_PIPELINE_ROOT/lib/verify.sh"

# Take the phase down with us. Without this, signalling the runner leaves the
# `claude -p` child running — with its full tool allowance, in the repository,
# indefinitely. See kill_descendants in lib/common.sh for what that cost once.
# 130 is the conventional "terminated by SIGINT" exit, and it is deliberately NOT
# 0: a run that was interrupted did not succeed.
_on_signal() {
  trap - INT TERM
  say ""
  warn "interrupted — stopping this run and any phase it started"
  kill_descendants $$
  exit 130
}
trap _on_signal INT TERM

# The bundled config is the default. SPEC_RUN_CONFIG lets you keep your own
# outside the package, which matters in plugin mode: the plugin lives under
# ~/.claude/plugins/cache/... and a plugin UPDATE replaces that directory, so an
# edit made there is a customisation with a deletion date. --config still wins
# over the environment, for a one-off.
CONFIG="${SPEC_RUN_CONFIG:-$SPECKIT_PIPELINE_ROOT/lib/phases.json}"

# ------------------------------------------------------------------ usage -----

usage() {
  cat <<'EOF'
spec-run — run the spec-kit phases, one isolated claude process each

USAGE
  spec-run [options] "<feature description>"    start a new feature
  spec-run [options]                            resume the current feature

OPTIONS
  --repo <path>          repository root (default: git toplevel of cwd)
  --add-dir <path>       grant every phase READ access to a directory outside the
                         repository (repeatable). A git worktree has no copy of a
                         gitignored sibling checkout, so grounding a spec in code
                         that lives elsewhere needs this; the phase still only
                         WRITES inside its declared scope.
  --claude-bin <cmd>     executable to run each phase with, instead of `claude`.
                         Also settable as SPEC_RUN_CLAUDE_BIN, or claude_bin in
                         phases.json. Use it for a wrapper that handles your
                         organisation's permission prompts. The named command is
                         probed, and any flag it does not advertise is reported.
  --feature-dir <path>   skip discovery, use this feature directory
  --config <file>        alternate phases.json (or set SPEC_RUN_CONFIG; the flag
                         wins). Use this to keep your tuning outside the plugin,
                         which a plugin update would otherwise overwrite.
  --from <phase>         start at this phase
  --stop-after <phase>   stop after this phase, whatever the config says
  --with <p[,p]>         also run optional phases (clarify, analyze, remediate)
  --only <p[,p]>         run exactly these phases
  --gate <all|none|p,..> override which phases pause for you
  --model <phase>=<m>    override one phase's model      (repeatable)
  --effort <phase>=<e>   override one phase's effort      (repeatable)
  --mcp <phase>=<none|inherit>
                         override whether one phase gets your MCP servers
                         (repeatable). Every MCP tool definition sits in the
                         CACHED PREFIX of every turn, so a phase that cannot use
                         them still pays for them on each one. Use this to
                         measure that: run the same phase both ways and compare
                         the cache_read column of cost.log.
  --budget <usd>         ceiling across the whole run
  --force                re-run phases already recorded ok
  --stream               show each phase's steps as they happen, instead of one
                         line per phase. Also settable as SPEC_RUN_STREAM=1.
  --dry-run              print the exact claude invocations, run nothing
  --list                 print the configured phases and exit
  --version              print the version and where this copy is installed
  -h, --help

PHASES
  specify → [clarify] → plan → tasks → [analyze] → implement
  Bracketed phases are optional; name them in --with to include them.

EXAMPLES
  spec-run "add a CSV export to the metrics page"
  spec-run --with clarify --stop-after plan "rework the auth flow"
  spec-run --resume
  spec-run --dry-run --only plan
EOF
}

# ----------------------------------------------------------------- args -------

REPO=""; FEATURE_DIR=""; DESCRIPTION=""; CLAUDE_BIN="${SPEC_RUN_CLAUDE_BIN:-}"
STREAM=${SPEC_RUN_STREAM:-0}
declare -a ADD_DIRS=()
FROM=""; STOP_AFTER=""; WITH=""; ONLY=""; GATE_OVERRIDE=""
BUDGET=""; FORCE=0; DRY_RUN=0; LIST=0
declare -a MODEL_OVERRIDES=() EFFORT_OVERRIDES=() MCP_OVERRIDES=()

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)         REPO="${2:-}"; shift 2 || exit 3;;
    --add-dir)      ADD_DIRS+=("${2:-}"); shift 2 || exit 3;;
    --claude-bin)   CLAUDE_BIN="${2:-}"; shift 2 || exit 3;;
    --feature-dir)  FEATURE_DIR="${2:-}"; shift 2 || exit 3;;
    --config)       CONFIG="${2:-}"; shift 2 || exit 3;;
    --from)         FROM="${2:-}"; shift 2 || exit 3;;
    --stop-after)   STOP_AFTER="${2:-}"; shift 2 || exit 3;;
    --with)         WITH="${2:-}"; shift 2 || exit 3;;
    --only)         ONLY="${2:-}"; shift 2 || exit 3;;
    --gate)         GATE_OVERRIDE="${2:-}"; shift 2 || exit 3;;
    --budget)       BUDGET="${2:-}"; shift 2 || exit 3;;
    --model)        MODEL_OVERRIDES+=("${2:-}"); shift 2 || exit 3;;
    --effort)       EFFORT_OVERRIDES+=("${2:-}"); shift 2 || exit 3;;
    --mcp)          MCP_OVERRIDES+=("${2:-}"); shift 2 || exit 3;;
    --force)        FORCE=1; shift;;
    --dry-run)      DRY_RUN=1; shift;;
    --stream)       STREAM=1; shift;;
    --no-stream)    STREAM=0; shift;;
    --list)         LIST=1; shift;;
    --resume)       shift;;   # resuming is the default when no description is given
    -h|--help)      usage; exit 0;;
    --version)      pipeline_version "${REPO:-}"; exit 0;;
    -*)             err "unknown option: $1"; usage >&2; exit 3;;
    *)              DESCRIPTION="${DESCRIPTION:+$DESCRIPTION }$1"; shift;;
  esac
done

[ -f "$CONFIG" ] || die "phase config not found: $CONFIG" \
  "pass --config, or reinstall speckit-pipeline"
jq -e . "$CONFIG" >/dev/null 2>&1 || die "phase config is not valid JSON: $CONFIG"

if [ "$LIST" -eq 1 ]; then
  printf '%-10s %-8s %-7s %-9s %-6s %s\n' PHASE MODEL EFFORT GATE OPT SKILL
  jq -r '.phases[] | [.id, .model, .effort, .gate, (if .optional then "yes" else "-" end), .skill]
         | @tsv' "$CONFIG" |
    while IFS=$'\t' read -r a b c d e f; do
      printf '%-10s %-8s %-7s %-9s %-6s %s\n' "$a" "$b" "$c" "$d" "$e" "$f"
    done
  exit 0
fi

# --------------------------------------------------------------- context ------

if [ -z "$REPO" ]; then
  REPO=$(git rev-parse --show-toplevel 2>/dev/null) || \
    die "not inside a git repository" "pass --repo <path>"
fi
REPO=$(cd -- "$REPO" && pwd)

# 🛑 An explicit --feature-dir is resolved against $REPO, exactly as a discovered
# one is (see discover_feature_dir). Both write the same variable, so both must
# mean the same thing — before this, discovery absolutised and the flag was taken
# verbatim, which made a relative --feature-dir silently depend on the CALLER's
# cwd. Measured: invoked with `--feature-dir specs/292-x` from a subdirectory of
# the repo, `tasks` wrote 65 tasks correctly and verify_phase looked for
# <subdir>/specs/292-x/tasks.md, reported "tasks.md was not created", recorded
# the phase `failed`, and halted the run — while the phase's own STATUS line in
# the same output said `ok`. The state dir was never created either.
#
# Normalised HERE rather than at parse time because $REPO is not known then: it
# may come from --repo or from `git rev-parse`, and the latter is resolved above.
if [ -n "$FEATURE_DIR" ]; then
  case "$FEATURE_DIR" in
    /*) : ;;
     *) FEATURE_DIR="$REPO/$FEATURE_DIR" ;;
  esac
fi

[ -n "$CLAUDE_BIN" ] || CLAUDE_BIN=$(jqd "$CONFIG" '.defaults.claude_bin' claude)
export SPEC_RUN_CLAUDE_BIN="$CLAUDE_BIN"

preflight "$REPO" || exit 1

# A --add-dir that does not exist is silently useless: the phase starts, cannot
# see what it was told to read, and produces a spec grounded in nothing.
if [ "${#ADD_DIRS[@]}" -gt 0 ]; then
  for _ad in "${ADD_DIRS[@]}"; do
    [ -n "$_ad" ] || continue
    [ -d "$_ad" ] || die_usage "--add-dir is not a directory: $_ad"
  done
fi

# Check the runner exists and runs, before the first phase is billed for
# anything. Flag support is NOT probed — see lib/common.sh for why the probe that
# tried was removed rather than kept as a warning nobody could rely on.
probe_claude_bin "$CLAUDE_BIN"; probe_rc=$?
case "$probe_rc" in
  0) ;;
  1) die "phase runner not on PATH: $CLAUDE_BIN" \
        "pass --claude-bin <cmd>, set SPEC_RUN_CLAUDE_BIN, or fix defaults.claude_bin";;
  2) warn "$CLAUDE_BIN is on PATH but exited non-zero on --help"
     warn "  the run continues; if it also rejects the flags each phase passes, the"
     warn "  phase will fail immediately and say so, with its stderr kept in"
     warn "  .pipeline/<phase>.result.json";;
esac

# Said BEFORE the first phase is billed, because if it applies, every phase dies
# identically and immediately — and says so in a traceback that names neither this
# tool nor the setting responsible.
_default_bin=$(jqd "$CONFIG" '.defaults.claude_bin' claude)
if runner_needs_tty_risk "$CLAUDE_BIN" "$_default_bin"; then
  warn "no controlling terminal, and the runner is '$CLAUDE_BIN' rather than '$_default_bin'"
  say  "  A wrapper that drives Claude through pexpect calls child.interact(),"
  say  "  which needs a terminal. With none, every phase dies at once."
  say  "  If that happens: --claude-bin $_default_bin  (or unset SPEC_RUN_CLAUDE_BIN)"
fi

# Optional phases only run when asked for; --only replaces the selection entirely.
_in_list() { case ",$1," in *",$2,"*) return 0;; *) return 1;; esac; }

# A phase name that does not exist must be a usage error, not a quiet nothing.
# Measured before this existed: `--only nosuchphase` selected no phases, ran
# nothing, printed six "not selected" lines and exited 0 — a silent no-op
# reported as success, which is the one outcome indistinguishable from the work
# having been done. The same held for --from, --with and --stop-after.
KNOWN_PHASES=$(jq -r '[.phases[].id] | join(",")' "$CONFIG")
_check_phase_names() { # _check_phase_names <flag> <comma-separated>
  local flag="$1" given="$2" name bad=""
  [ -n "$given" ] || return 0
  local IFS=,
  for name in $given; do
    [ -n "$name" ] || continue
    _in_list "$KNOWN_PHASES" "$name" || bad="${bad:+$bad, }$name"
  done
  [ -z "$bad" ] && return 0
  die_usage "$flag names a phase that does not exist: $bad" \
            "configured phases are: $(printf '%s' "$KNOWN_PHASES" | tr ',' ' ')"
}
_check_phase_names --only "$ONLY"
_check_phase_names --with "$WITH"
_check_phase_names --from "$FROM"
_check_phase_names --stop-after "$STOP_AFTER"
# --gate takes `all`, `none`, or a phase list; only the last form names phases.
case "$GATE_OVERRIDE" in
  all|none|"") ;;
  *) _check_phase_names --gate "$GATE_OVERRIDE";;
esac

# The model/effort/mcp overrides name phases too.
for _o in "${MODEL_OVERRIDES[@]:-}" "${EFFORT_OVERRIDES[@]:-}" "${MCP_OVERRIDES[@]:-}"; do
  [ -n "$_o" ] || continue
  case "$_o" in
    *=*) _check_phase_names "--model/--effort/--mcp" "${_o%%=*}";;
    *)   die_usage "override must be <phase>=<value>, got: $_o";;
  esac
done
# `--mcp plan=non` must not silently mean `inherit`. The value here decides
# whether a whole tool list is loaded, and the two spellings are indistinguishable
# in the output — the run would simply cost more than the flag said it would.
for _o in "${MCP_OVERRIDES[@]:-}"; do
  [ -n "$_o" ] || continue
  case "${_o#*=}" in
    none|inherit) ;;
    *) die_usage "--mcp takes none or inherit, got: ${_o#*=}";;
  esac
done

phase_selected() { # phase_selected <id> <optional>
  local id="$1" optional="$2"
  if [ -n "$ONLY" ]; then _in_list "$ONLY" "$id" && return 0 || return 1; fi
  if [ "$optional" = "true" ]; then _in_list "$WITH" "$id" && return 0 || return 1; fi
  return 0
}

override_for() { # override_for <phase> <"model"|"effort"|"mcp">  -> prints override or nothing
  local phase="$1" kind="$2" entry
  local -a list=()
  case "$kind" in
    model)  list=("${MODEL_OVERRIDES[@]:-}");;
    effort) list=("${EFFORT_OVERRIDES[@]:-}");;
    mcp)    list=("${MCP_OVERRIDES[@]:-}");;
  esac
  for entry in "${list[@]}"; do
    [ -n "$entry" ] || continue
    case "$entry" in "$phase="*) printf '%s\n' "${entry#*=}"; return 0;; esac
  done
}

# The phase skills must be resolvable as PROJECT skills, not from a plugin
# namespace: spec-kit's hooks resolve to bare slash commands like
# `/speckit-git-feature`, which under a plugin namespace silently fail to
# resolve — the branch is never created and the phase reports success over a
# directory nothing downstream can find.
#
# WHICH skills are required is derived, not hardcoded. Two sources, each
# authoritative for its half:
#   * the phases this run will execute, from phases.json;
#   * whatever THIS PROJECT's .specify/extensions.yml hooks into those phases.
#
# The hardcoded list this replaces demanded `speckit-git-feature`, which
# spec-kit 0.7.3 ships and 0.11.3 REMOVED — 0.11.3 dropped the git extension
# entirely and lets specify create the directory without a branch. So the tool
# refused to run in every 0.11.3 project, and the remedy it printed
# (spec-bootstrap) would have installed 0.7.3's git skills into a 0.11.3
# project, mixing two versions. A requirement invented by this tool rather than
# read from the project is a compatibility bug waiting for the next release.
_missing_skills=""
_require_skill() {
  [ -d "$REPO/.claude/skills/$1" ] ||     case " $_missing_skills " in *" $1 "*) ;; *) _missing_skills="${_missing_skills:+$_missing_skills }$1";; esac
}

# the phases themselves
_ri=0
_rn=$(jq -r '.phases | length' "$CONFIG")
while [ "$_ri" -lt "$_rn" ]; do
  _rskill=$(jq -r ".phases[$_ri].skill" "$CONFIG")
  _ri=$((_ri + 1))
  _require_skill "$_rskill"
done

# whatever the project hooks into them. `speckit.git.feature` becomes
# `/speckit-git-feature`, which is the substitution the skills themselves
# document, so it is the substitution used here.
if [ -f "$REPO/.specify/extensions.yml" ]; then
  while IFS= read -r _hook; do
    [ -n "$_hook" ] || continue
    _require_skill "$(printf '%s' "$_hook" | tr '.' '-')"
  done <<EOF
$(grep -E '^[[:space:]]*-?[[:space:]]*command:[[:space:]]*speckit\.' "$REPO/.specify/extensions.yml" 2>/dev/null |
   sed 's/.*command:[[:space:]]*//' | sort -u)
EOF
fi

if [ -n "$_missing_skills" ]; then
  err "this project is missing skills the pipeline needs:"
  for _s in $_missing_skills; do printf '    .claude/skills/%s\n' "$_s" >&2; done
  printf '  install them: %s/bin/spec-bootstrap %s\n' "$SPECKIT_PIPELINE_ROOT" "$REPO" >&2
  printf '  (the phase skills come from phases.json; the rest are whatever this\n' >&2
  printf '   project hooks in .specify/extensions.yml)\n' >&2
  exit 1
fi

# ------------------------------------------------- feature dir discovery ------
# Before the first phase there is no feature directory: /speckit-specify is what
# creates the branch and the directory. So discovery runs again after specify.

discover_feature_dir() {
  local fj="$REPO/.specify/feature.json" rel=""
  if [ -f "$fj" ]; then
    rel=$(jq -r '.feature_directory // empty' "$fj" 2>/dev/null)
  fi
  if [ -z "$rel" ] && [ -x "$REPO/.specify/scripts/bash/check-prerequisites.sh" ]; then
    rel=$( cd "$REPO" && ./.specify/scripts/bash/check-prerequisites.sh --json 2>/dev/null |
           jq -r '.FEATURE_DIR // empty' 2>/dev/null )
  fi
  [ -n "$rel" ] || return 1
  case "$rel" in /*) printf '%s\n' "$rel";; *) printf '%s\n' "$REPO/$rel";; esac
}

# Adopting an existing feature is RESUME behaviour, and a description means the
# opposite: a new feature, which /speckit-specify is what creates. Discovering
# first regardless made `spec-run "a second feature"` adopt whatever
# .specify/feature.json still pointed at, find its specify phase already `ok`,
# skip it, and run nothing new — silently continuing the previous feature under a
# new description. Found through the roadmap runner, where entry two inherited
# entry one's spec, but it was never roadmap-specific: it is what a second
# feature in any repository would have done.
if [ -z "$FEATURE_DIR" ] && [ -z "$DESCRIPTION" ]; then
  FEATURE_DIR=$(discover_feature_dir || true)
fi

STATE=""
init_state_if_possible() {
  [ -n "$FEATURE_DIR" ] && [ -d "$FEATURE_DIR" ] || return 1
  STATE="$FEATURE_DIR/.pipeline/state.json"
  state_init "$STATE" "$FEATURE_DIR" "$(git -C "$REPO" rev-parse --abbrev-ref HEAD)" "$DESCRIPTION"
  # Before deciding what to run, settle what the last run left behind. A phase
  # still marked `running` from a killed invocation would otherwise be read as
  # in flight by everything downstream.
  state_reconcile_running "$STATE"
}
init_state_if_possible || true

# ------------------------------------------------------------ phase runner ----

COST_LOG=""
RUN_TOTAL=0

# The token columns are the whole reason this log is worth keeping. Cost and turns
# say WHAT a phase spent; only the token split says WHERE, and the split is not
# close to even. Measured across 40 real phase envelopes on this machine, cache
# reads are 60-75% of a phase's bill, cache writes ~20% (the 1-hour TTL doubles
# their price), and output — the only part that is the actual work — is 10-15%.
#
# read/turn is the figure to tune against: cache_read divided by turns is the
# AVERAGE RESIDENT CONTEXT, because every turn re-reads everything before it. A
# real plan phase read 17,946,392 cached tokens over 96 turns, so it was carrying
# ~187k tokens on every one of them. That number, not the turn count, is what a
# shorter pass or a smaller preamble actually moves.
#
# All four are recorded RAW rather than priced. A dollar figure needs a per-model
# rate table, and a rate table in here goes stale silently the first time
# Anthropic reprices anything — at which point the log would be confidently wrong
# about the one thing it exists to measure. Tokens are what was observed.
init_cost_log() {
  [ -n "$FEATURE_DIR" ] || return 0
  COST_LOG="$FEATURE_DIR/.pipeline/cost.log"
  mkdir -p "$(dirname "$COST_LOG")"
  [ -f "$COST_LOG" ] || \
    printf '# started_at\tphase\tmodel\teffort\tcost_usd\tturns\tduration_ms\tcache_read\tcache_write\tinput\toutput\n' \
      > "$COST_LOG"
}

# Everything the phase must know that is not in the skill: which phase it is,
# that the skill is to be invoked rather than imitated, and that finishing means
# finishing this phase only. The tool denials are enforced by the harness; they
# are restated here so a refusal reads as a rule rather than a malfunction.
handoff_contract() { # handoff_contract <phase_id> <skill_ref> <feature_dir>
  cat <<EOF
You are running exactly one phase of a spec-kit pipeline: "$1".

Invoke the skill \`$2\` using the Skill tool and let it do its work. Never
approximate, summarise or re-implement what the skill does — it carries the
project's constitution, templates and hooks, and skipping it silently produces
artifacts the rest of the pipeline cannot use.

Do this phase and stop. A later process runs the next phase; the handoff between
you is the files on disk, so leave them complete and leave nothing half-written.
Do not start the next phase even if it looks trivial.

Pushing, merging pull requests, and triggering deploys are withheld from you as
tools for every phase but implementation, and withheld everywhere for merges.
That is deliberate and not a fault to work around.

YOU ARE HEADLESS. There is no human watching you, no monitor attached to you, and
nobody who can notify you when something finishes. So RUN LONG COMMANDS
SYNCHRONOUSLY and wait for them to return — a test suite, a build, a simulation,
however many minutes it takes. Do NOT start work in the background and then poll
for it, sleep, or wait to be told it is done: the notification you are waiting for
cannot arrive, and the wait does not end. Measured: a phase launched a 5-seed
balance run in the background and then spent its remaining budget on \`sleep 1\`
and \`echo waiting\`, having written its last real change 40 minutes earlier.

For the same reason, redirect stdin on anything that might prompt
(\`< /dev/null\`), so a command that wants input fails immediately instead of
blocking forever on input that will never come.

${3:+The feature directory for this run is $3.}
$(handoff_extra "$1" "${4:-}")
Finish your final message with one line of the form:
STATUS: ok | needs_input | failed — <one sentence>
and, if needs_input, the specific questions a human must answer.
EOF
}

# Phase-specific additions. Kept here rather than in the vendored skill so an
# upgrade cannot silently drop them.
handoff_extra() { # handoff_extra <phase_id> <chunked>
  [ "$1" = implement ] || return 0
  if [ "${2:-}" = true ]; then
    cat <<'EOF'

YOU ARE ONE PASS OF A CHUNKED PHASE. Complete AT MOST ONE `## Phase` group of
tasks from tasks.md — the next group with unchecked boxes — and then stop and
report. Another process picks up the following group, reading the tasks.md you
leave behind. Do not attempt the whole list.

Stop at a `## Phase` boundary rather than after some count of tasks: the groups
are semantic, so tasks inside one are coupled and tasks across them are not.
Splitting mid-group would hand the next pass a spec whose implementation is
half-written, with no record of why the first half looks as it does.

If the next group is very large, doing part of it is acceptable — but tick
exactly what you finished, and leave nothing half-applied.

AND PREFER TO STOP EARLY WHEN A PASS RUNS LONG. Note the time when you start. Once
you are past roughly 15 minutes, finish the task in flight, tick it, and stop at
that task boundary even if the group has more in it. Report what is left; the next
pass continues from your tasks.md.

This is worth doing because of how a pass is billed. Cost is dominated by re-reading
the transcript: one measured pass reported 27,706,579 cache-read tokens against
28,608 output tokens. Every turn re-reads everything before it, so the cost of a
pass grows with roughly the SQUARE of its length — which means two short passes are
substantially cheaper than one long one covering the same tasks, because each starts
from a clean prefix.

Measured across the 14 passes of one entry, turns per pass were:
39 94 90 67 60 45 70 97 75 94 76 58 104 46 (mean 72, max 104). The long ones are
where the money went.

⚠️ Wall clock, not turns, deliberately: you cannot observe your own turn count — the
CLI reports it only in its final result — so a turn target would be something you
could not act on. Time you can read. And this is a PREFERENCE, not a hard stop:
finishing a coupled pair of tasks is worth two extra minutes, whereas pushing
through another eight tasks is not.
EOF
    tasks_digest "${FEATURE_DIR:-}"
  fi
  cat <<'EOF'

TICK EACH TASK IN tasks.md THE MOMENT YOU FINISH IT, before starting the next one.
Do not batch the updates and do not leave them to the end. tasks.md is not a
report you file on the way out — it is the HANDOFF, the one record of what landed,
and everything you have not ticked is invisible to whatever runs next.

What batching costs, measured: a phase was interrupted having modified 34 files
with 0 of 57 tasks ticked, so nothing on disk said which of them were done. The
recovery was a separate `converge` phase — 61 turns and $8.06 — spent entirely on
re-deriving from the source code what an accurate tasks.md would simply have
stated. A later run of the same feature reached ~90% complete while the file still
read 16/76, so a human reviewing it could not tell the work was nearly finished.

Ticking as you go also means an interruption costs only the task in flight, and it
lets your own work be resumed in a fresh process rather than restarted.

VERIFY NARROWLY AS YOU GO, BROADLY ONCE AT THE END. Per task, run the smallest
check that can fail for the right reason — the single test file you touched, a
typecheck of the package, one focused `-k` selection. Run the FULL suite once, at
the end of the pass, after the last task you intend to tick.

Why, measured on one pass: it reported 27,706,579 cache-read tokens against 28,608
output tokens — a ratio of 968 to 1. Practically all of the cost of a pass is
re-reading its own transcript on every turn, so anything large dumped early is paid
for again by every turn that follows it. That pass had 9 tool results over 4k
characters, together about 27k tokens, mostly full-suite output. Four full-suite
runs mid-pass cost far more than the one at the end, and tell you no more.

TRUNCATE what you do run. Pipe verification through `tail -30` (or `tail -60` when
a failure needs context) rather than letting thousands of lines into the transcript.
On a failure, re-run just the failing file to get its detail — that is cheaper than
having carried every passing line along with it. Never `cat` a lockfile, a build
log or a generated bundle into the transcript at all.
EOF
}

# How many tasks are still unchecked. This is the ONLY authority on whether a
# chunked phase is finished — not the recorded status, which describes one pass.
tasks_unchecked() { # tasks_unchecked <feature_dir>
  local f="${1:-}/tasks.md" c
  [ -f "$f" ] || { printf '0\n'; return 0; }
  # `grep -c` PRINTS 0 and EXITS 1 when nothing matches, so a `|| printf 0`
  # fallback emits "0\n0" — which then fails every numeric test that reads it.
  c=$(grep -c '^[[:space:]]*-[[:space:]]*\[[[:space:]]\]' "$f" 2>/dev/null) || c=0
  printf '%s\n' "${c:-0}"
}

# Where the next pass should start, computed HERE and handed over in the prompt.
#
# The runner already knows this — tasks_unchecked() above reads the same file —
# and every pass was re-deriving it anyway. Measured in the run logs of one
# entry, passes opened with turns spent on shapes like
#   awk '/^#+ Phase/{...} /- \[/{if ($0 ~ /- \[ \]/) unchecked[phase]++}' tasks.md
#   awk 'NR>=2215 && /^class /{print NR": "$0}' src/main.py | head -5
# to establish which group was next. Those turns are not just their own cost:
# their output joins the prefix that EVERY later turn of the pass re-reads, so a
# discovery turn is paid for once and then again per turn thereafter.
#
# Stated as fact rather than instruction, and deliberately not as the only
# source: the pass still reads tasks.md, because this digest is a pointer and the
# tasks are the work. What it removes is the search, not the reading.
tasks_digest() { # tasks_digest <feature_dir>
  local f="${1:-}/tasks.md"
  [ -f "$f" ] || return 0
  # One awk pass, because three greps over a large tasks.md is the same mistake
  # in miniature. Groups are `## Phase ...` headings; a task is a checkbox line.
  # Tasks before any heading are attributed to a synthetic "(no group)" so a
  # tasks.md written without headings still gets a digest rather than an empty one.
  awk '
    /^#+[[:space:]]*Phase/ { group = $0; sub(/^#+[[:space:]]*/, "", group)
                             order[++ng] = group; seen[group] = 1; next }
    /^[[:space:]]*[-*][[:space:]]*\[[[:space:]xX]\]/ {
      g = (group == "" ? "(no group)" : group)
      if (!seen[g]) { order[++ng] = g; seen[g] = 1 }
      total[g]++; tot++
      if ($0 ~ /^[[:space:]]*[-*][[:space:]]*\[[[:space:]]\]/) {
        un[g]++; unt++
        # The task id, when there is one: `- [ ] T045 [P] do the thing`.
        if (match($0, /T[0-9]+/)) ids[g] = ids[g] (ids[g] == "" ? "" : " ") substr($0, RSTART, RLENGTH)
      }
    }
    END {
      if (tot == 0) exit 0
      groups_left = 0
      for (i = 1; i <= ng; i++) if (un[order[i]] > 0) groups_left++
      nextg = ""
      for (i = 1; i <= ng && nextg == ""; i++) if (un[order[i]] > 0) nextg = order[i]
      if (nextg == "") exit 0
      printf "\nWHERE YOU ARE IN tasks.md — the runner computed this before starting you,\n"
      printf "so you do not need to scan the file to find your place:\n"
      printf "  next group:  %s\n", nextg
      printf "  its tasks:   %s\n", (ids[nextg] == "" ? "(unnumbered)" : ids[nextg])
      printf "               %d unchecked of %d in this group\n", un[nextg], total[nextg]
      printf "  overall:     %d unchecked of %d, across %d group(s) with work left\n", unt, tot, groups_left
      printf "Go to that group and do it. Do not re-count the file to work out where to\n"
      printf "start — that costs turns, and every turn after it re-reads the result.\n"
    }
  ' "$f" 2>/dev/null || true
}

# Run a phase repeatedly, each pass a FRESH process, until its task list is clear.
#
# Why: cost is ~linear in cache_read, which is ~98% of a phase's input and grows
# with turn count, so a phase of T turns costs roughly 90k*T + 0.7k*T^2 tokens.
# Splitting it into k passes leaves the linear term alone and divides the
# quadratic one by k. Measured on one entry: an implement phase estimated at ~600
# turns costs ~306M tokens in one pass and ~96M in six — about 3x.
#
# Two things make it safe rather than merely cheaper:
#
#   * COMPLETION IS THE ARTIFACT, NOT THE STATUS. run_phase skips anything already
#     recorded `ok`, which would end the loop after one pass. For a chunked phase
#     that check is simply wrong: unchecked boxes mean unfinished work whatever
#     state says. So FORCE is raised for the duration and restored after.
#   * A PASS THAT TICKS NOTHING ENDS THE LOOP. Without that, a phase that cannot
#     make progress becomes an unbounded spend loop — a worse failure than the
#     truncation this replaces, because it is silent and costs money per turn.
run_phase_chunked() { # run_phase_chunked <phase_json>
  local pj="$1" id max_passes pass=0 before after rc
  local tot_cost=0 tot_turns=0 c n saved_force="$FORCE"
  # Token totals across the passes, for the same reason cost and turns are
  # totalled: each pass overwrites the phase's record, so without this the state
  # file reports the LAST pass's tokens as the phase's. On a twelve-pass implement
  # that understates the phase by an order of magnitude — and it is the phase most
  # worth measuring, so the field would be most wrong exactly where it matters.
  local tot_read=0 tot_write=0 tot_in=0 tot_out=0 u
  id=$(jq -r '.id' <<<"$pj")
  max_passes=$(jq -r '.max_passes // 12' <<<"$pj")

  # An ABSENT task list is not a finished one. Chunking needs an artifact to
  # measure progress against; with none there is nothing to loop on, and treating
  # that as "no work to do" would skip the phase entirely — a silent no-op
  # indistinguishable from success. Run once, normally, and say why.
  if [ ! -f "${FEATURE_DIR:-}/tasks.md" ]; then
    warn "$id — no tasks.md to chunk on; running once as a single pass"
    run_phase "$pj"; return $?
  fi

  FORCE=1
  while :; do
    before=$(tasks_unchecked "${FEATURE_DIR:-}")
    if [ "${before:-0}" -eq 0 ]; then
      FORCE="$saved_force"
      if [ "$pass" -eq 0 ]; then
        dim "  · $id — no unchecked tasks; nothing to do"
      else
        ok "$id — task list clear after $pass pass(es)"
        if [ -n "$STATE" ] && [ "$DRY_RUN" -eq 0 ]; then
          state_phase_set_totals "$STATE" "$id" "$tot_cost" "$tot_turns" "$pass"
          state_phase_set_usage  "$STATE" "$id" "$tot_read" "$tot_write" "$tot_in" "$tot_out"
        fi
      fi
      return 0
    fi

    pass=$((pass + 1))
    if [ "$pass" -gt "$max_passes" ]; then
      FORCE="$saved_force"
      err "$id — $max_passes passes used with $before task(s) still unchecked"
      say  "  Raise max_passes only if each pass was making real progress; if it"
      say  "  was not, the task list is asking for something it cannot finish."
      return 1
    fi

    # Deliberately NOT info(): its `→` marker means "a phase is starting", and a
    # pass is not a phase. Emitting it here made implement announce itself twice
    # and broke the count that proves no phase was silently skipped.
    say "  pass $pass/$max_passes — $before task(s) unchecked"
    run_phase "$pj"; rc=$?
    if [ "$rc" -ne 0 ]; then FORCE="$saved_force"; return "$rc"; fi

    if [ -n "$STATE" ] && [ "$DRY_RUN" -eq 0 ]; then
      c=$(state_phase_get "$STATE" "$id" cost_usd 0)
      n=$(state_phase_get "$STATE" "$id" num_turns 0)
      tot_cost=$(awk -v a="$tot_cost" -v b="$c" 'BEGIN{printf "%.10g", a + b}')
      tot_turns=$((tot_turns + ${n:-0}))
      u=$(state_phase_get "$STATE" "$id" 'usage.cache_read_tokens'  0); tot_read=$((tot_read   + ${u:-0}))
      u=$(state_phase_get "$STATE" "$id" 'usage.cache_write_tokens' 0); tot_write=$((tot_write + ${u:-0}))
      u=$(state_phase_get "$STATE" "$id" 'usage.input_tokens'       0); tot_in=$((tot_in       + ${u:-0}))
      u=$(state_phase_get "$STATE" "$id" 'usage.output_tokens'      0); tot_out=$((tot_out     + ${u:-0}))
    fi

    after=$(tasks_unchecked "${FEATURE_DIR:-}")
    if [ "${after:-0}" -ge "${before:-0}" ]; then
      FORCE="$saved_force"
      # A stalled loop is WAITING ON YOU, not broken — exit 2, not 1. The two are
      # different facts and the roadmap treats them differently: 1 fails the entry
      # and stops the roadmap, 2 hands it to a human with the work intact.
      #
      # Measured on the entry that prompted this: 50 of 51 tasks were done and the
      # only one left was "follow the browser check in quickstart.md §5", which a
      # headless phase structurally CANNOT do. Reporting that as a failed entry
      # describes it wrongly — nothing failed, the remainder simply is not the
      # phase's to do. The guard still stops the loop, which is its whole point;
      # it just stops calling this a failure.
      warn "$id — pass $pass ticked nothing ($before → $after unchecked); stopping the loop"
      say  "  Looping again would spend without progressing. Either the remaining"
      say  "  task(s) need a human — a browser check, a judgement call, a decision"
      say  "  — or the phase is stuck. They are distinguishable only by reading"
      say  "  them, so read them:"
      grep -n '^[[:space:]]*-[[:space:]]*\[[[:space:]]\]' "${FEATURE_DIR:-}/tasks.md" 2>/dev/null |
        head -5 | cut -c1-160 | sed 's/^/    /'
      say  "  and the phase's own account: ${FEATURE_DIR:-<feature>}/.pipeline/$id.result.json"
      if [ -n "$STATE" ] && [ "$DRY_RUN" -eq 0 ]; then
        state_phase_set_totals "$STATE" "$id" "$tot_cost" "$tot_turns" "$pass"
        state_phase_set_usage  "$STATE" "$id" "$tot_read" "$tot_write" "$tot_in" "$tot_out"
      fi
      return 2
    fi
    [ "$DRY_RUN" -eq 1 ] && { FORCE="$saved_force"; return 0; }
  done
}

run_phase() { # run_phase <phase_json>
  local pj="$1"
  local id skill model effort artifact gate maxb maxt mcp optional
  id=$(jq -r '.id' <<<"$pj")
  skill=$(jq -r '.skill' <<<"$pj")
  model=$(jq -r '.model' <<<"$pj")
  effort=$(jq -r '.effort' <<<"$pj")
  artifact=$(jq -r '.artifact // ""' <<<"$pj")
  gate=$(jq -r '.gate // "on_needs_input"' <<<"$pj")
  maxb=$(jq -r '.max_budget_usd // empty' <<<"$pj")
  maxt=$(jq -r '.max_turns // empty' <<<"$pj")
  mcp=$(jq -r '.mcp // "inherit"' <<<"$pj")
  optional=$(jq -r '.optional // false' <<<"$pj")

  local o
  o=$(override_for "$id" model); [ -n "$o" ] && model="$o"
  o=$(override_for "$id" effort); [ -n "$o" ] && effort="$o"
  o=$(override_for "$id" mcp); [ -n "$o" ] && mcp="$o"

  valid_model "$model"  || die "phase '$id': not a model alias: $model" \
    "expected one of: opus sonnet haiku fable, or a full claude-* id"
  valid_effort "$effort" || die "phase '$id': not an effort level: $effort" \
    "expected one of: low medium high xhigh max"

  # already done?
  if [ -n "$STATE" ] && [ "$FORCE" -eq 0 ]; then
    local prev
    prev=$(state_phase_get "$STATE" "$id" status "")
    if [ "$prev" = "ok" ]; then
      dim "  · $id — already ok, skipping (use --force to re-run)"
      return 0
    fi
  fi

  # overall budget ceiling, checked BEFORE the spend rather than after
  if [ -n "$BUDGET" ] && [ -n "$STATE" ]; then
    local spent
    spent=$(state_total_cost "$STATE")
    if awk -v s="$spent" -v b="$BUDGET" 'BEGIN{exit !(s >= b)}'; then
      err "run budget of \$$BUDGET reached (\$$spent spent) before phase '$id'"
      return 1
    fi
  fi

  # ---- skill reference and prompt
  local skill_ref prompt
  skill_ref="$skill"
  prompt="/$skill_ref"
  if [ "$(jq -r '.takes_description // false' <<<"$pj")" = true ] && [ -n "$DESCRIPTION" ]; then
    prompt="/$skill_ref $DESCRIPTION"
  fi

  # ---- tool denials: defaults plus this phase's own
  local deny
  deny=$(jq -r '[ (.defaults.deny_tools // [])[] ] | join(",")' "$CONFIG")
  local phase_deny
  phase_deny=$(jq -r '(.deny_tools // []) | join(",")' <<<"$pj")
  [ -n "$phase_deny" ] && deny="${deny:+$deny,}$phase_deny"
  # Implementation is the one phase that may legitimately push a branch.
  if [ "$id" = implement ]; then
    deny=$(printf '%s' "$deny" | tr ',' '\n' | grep -v '^Bash(git push:\*)$' |
           grep -v '^Bash(gh pr create:\*)$' | paste -sd, -)
  fi

  # ---- a FRESH session id for this attempt (see state_phase_push_session)
  local sid
  sid=$(new_uuid)

  # ---- assemble argv
  local out_format=json
  # stream-json emits an event per step rather than one blob at the end. The
  # result event is still the last JSON object on stdout, so everything
  # downstream — cost, turns, denials, the artifact verdict — is unchanged.
  [ "$STREAM" -eq 1 ] && out_format=stream-json
  # 🛑 Hold a power assertion for the phase's lifetime. `pmset` on the machine this
  # was written for reports `sleep 1` — one minute of idle — and a phase runs for
  # tens of minutes, so it is racing a sleep it does not hold off. Measured cost of
  # not doing this, in one entry: the tasks phase died with exit 137 and an empty
  # stderr (which reads like an OOM and is not), and one implement pass spent $7.89
  # to return "API Error: Your computer went to sleep mid-response" and tick nothing.
  # Two different signatures, one cause.
  #
  # `caffeinate -i` prevents idle sleep only — deliberately not `-d` (the display may
  # sleep) and not `-s` (which only applies on AC power and would silently do nothing
  # on battery). As a child of the phase it dies with it, so nothing is left holding
  # the machine awake after a run.
  local -a wake=()
  if command -v caffeinate >/dev/null 2>&1; then wake=(caffeinate -i); fi
  # ⚠️ `${wake[@]+"${wake[@]}"}` and NOT `"${wake[@]}"`: on bash 3.2 — still the
  # system shell on macOS — expanding an EMPTY array under `set -u` raises
  # "unbound variable" rather than expanding to nothing. So the plain form works
  # only where caffeinate exists and breaks the runner outright everywhere it does
  # not, which is every Linux host. Found by mutation: removing the caffeinate
  # branch failed 88 assertions, not the 1 that was supposed to fail.
  local -a argv=(${wake[@]+"${wake[@]}"} "$CLAUDE_BIN" -p "$prompt"
    --model "$model"
    --effort "$effort"
    --output-format "$out_format"
    --permission-mode "$(jqd "$CONFIG" '.defaults.permission_mode' acceptEdits)"
    --session-id "$sid"
    --append-system-prompt "$(handoff_contract "$id" "$skill_ref" "${FEATURE_DIR:-}" "$(jq -r '.chunked // false' <<<"$pj")")"
  )
  [ "$STREAM" -eq 1 ] && argv+=(--verbose)
  [ -n "$maxt" ] && argv+=(--max-turns "$maxt")
  [ -n "$maxb" ] && argv+=(--max-budget-usd "$maxb")
  [ -n "$deny" ] && argv+=(--disallowed-tools "$deny")
  # Read access outside the repository. The write scope is unchanged and still
  # checked after the phase, so this widens what a phase can LOOK at without
  # widening what it may leave behind.
  if [ "${#ADD_DIRS[@]}" -gt 0 ]; then
    for _ad in "${ADD_DIRS[@]}"; do
      [ -n "$_ad" ] && argv+=(--add-dir "$_ad")
    done
  fi
  # A phase that talks to nothing external should not pay for a tool list it
  # cannot use; one that drives a browser or an API must keep it.
  if [ "$mcp" = none ]; then argv+=(--strict-mcp-config --mcp-config '{"mcpServers":{}}'); fi

  # mcp is stated, not assumed. It is now overridable per run, and whether a tool
  # list was loaded is invisible in the output while being one of the larger
  # things a phase pays for on every turn — the same reason an unapplied ceiling
  # must not read as an applied one.
  info "$id — $model/$effort${maxb:+, ≤\$$maxb}${maxt:+, ≤$maxt turns}, mcp $mcp"

  if [ "$DRY_RUN" -eq 1 ]; then
    printf '  '; printf '%q ' "${argv[@]}"; printf '\n\n'
    return 0
  fi

  if [ -n "$STATE" ]; then
    state_phase_start "$STATE" "$id" "$sid" "$model" "$effort"
    state_phase_push_session "$STATE" "$id" "$sid"
  fi

  # ---- the artifact's state BEFORE the phase, so "nothing happened" is
  # distinguishable from "happened and verified". Without this, a phase that
  # exits instantly verifies clean against its predecessor's output.
  local sha_before=""
  [ -n "${artifact:-}" ] && [ "$artifact" != null ] && \
    sha_before=$(file_sha "${FEATURE_DIR:-}/$artifact")

  # ---- declared write scope, and a snapshot of what is ALREADY dirty outside it
  local scope_json
  scope_json=$(jq -c 'if has("write_scope") then .write_scope else "inherit" end' <<<"$pj")
  local -a prefixes=()
  if [ "$scope_json" = '"inherit"' ]; then
    while IFS= read -r p; do [ -n "$p" ] && prefixes+=("$p"); done < \
      <(jq -r '(.defaults.write_scope // [])[]' "$CONFIG")
  elif [ "$scope_json" != null ]; then
    while IFS= read -r p; do [ -n "$p" ] && prefixes+=("$p"); done < \
      <(jq -r '.[]' <<<"$scope_json")
  fi
  # Whatever spec-kit's own update-agent-context.sh may write is in scope for any
  # phase that has a scope at all: it is the pipeline's file, not the phase going
  # off-piste.
  if [ "${#prefixes[@]}" -gt 0 ]; then
    while IFS= read -r p; do [ -n "$p" ] && prefixes+=("$p"); done < \
      <(agent_context_paths "$REPO")
  fi

  local snap=""
  if [ "${#prefixes[@]}" -gt 0 ]; then
    snap=$(mktmp)
    scope_snapshot "$REPO" "$snap" "${prefixes[@]}"
  fi

  # ---- run
  # stderr is kept SEPARATE from stdout: merging them means one warning line on
  # stderr makes the JSON unparseable, and the parse below would then read cost
  # and turns as zero. A zero that means "not measured" is the most expensive
  # kind of tidy number.
  local out rc errf
  errf=$(mktmp)
  # </dev/null so the phase cannot consume anything the caller is reading. The
  # index-based loop above already removes the dependency; this makes it
  # impossible to reintroduce by restructuring the loop later.
  if [ "$STREAM" -eq 1 ]; then
    # The filter writes its condensed view to stderr and passes the stream
    # through, so this capture is unchanged and the progress appears live.
    out=$( cd "$REPO" && "${argv[@]}" 2>"$errf" </dev/null | stream_progress "$REPO" ); rc=$?
  else
    out=$( cd "$REPO" && "${argv[@]}" 2>"$errf" </dev/null ); rc=$?
  fi

  # The feature directory only exists once specify has run: /speckit-specify is
  # what creates the branch and the directory. So the first phase of a new
  # feature has nowhere to record itself until after it finishes — discover the
  # directory now and backfill, including the cost log, which would otherwise be
  # missing exactly one phase on every new feature.
  if [ -z "$STATE" ]; then
    FEATURE_DIR=$(discover_feature_dir || true)
    if init_state_if_possible; then
      state_phase_start "$STATE" "$id" "$sid" "$model" "$effort"
      init_cost_log
    fi
  fi

  local cost turns dur result unmeasured="" json="" errcap="" denials=0 denied_tools="" denial_note=""
  local cli_error="" cli_subtype=""
  local tok_read="" tok_write="" tok_in="" tok_out=""
  errcap=$(head -c 4000 "$errf" 2>/dev/null || true)
  json=$(extract_result_json "$out") || json=""
  if [ -n "$json" ]; then
    cost=$(jq -r '.total_cost_usd // empty' <<<"$json")
    turns=$(jq -r '.num_turns // empty'     <<<"$json")
    dur=$(jq -r '.duration_ms // empty'     <<<"$json")
    result=$(jq -r '.result // empty'       <<<"$json")
    # The token split, from the envelope's own usage block. `// empty` and not
    # `// 0` for the same reason cost uses it: a runner that reports no usage and
    # a phase that genuinely read nothing must not record the same figure. A
    # measured 0 is news; an unmeasured 0 is a lie that looks like good news.
    tok_read=$(jq  -r '.usage.cache_read_input_tokens // empty'     <<<"$json")
    tok_write=$(jq -r '.usage.cache_creation_input_tokens // empty' <<<"$json")
    tok_in=$(jq    -r '.usage.input_tokens // empty'                <<<"$json")
    tok_out=$(jq   -r '.usage.output_tokens // empty'               <<<"$json")
    # The runner's OWN verdict on itself. It is not a hint to be weighed against
    # the artifact: `is_error` means the phase stopped without finishing, and
    # `subtype` says how — `error_max_turns` above all.
    #
    # Measured: a plan phase hit its 80-turn cap having written research.md,
    # data-model.md, four contracts and quickstart.md, but leaving plan.md as the
    # UNFILLED TEMPLATE. The envelope said {"subtype":"error_max_turns",
    # "is_error":true,"num_turns":81} and the pipeline recorded `ok`, because the
    # template is over the size floor and carries no open markers. The next phase
    # then planned against a placeholder. Asking the runner is cheaper and far
    # more reliable than inferring completion from bytes on disk.
    cli_error=$(jq -r 'if .is_error == true then "1" else "" end' <<<"$json" 2>/dev/null || true)
    cli_subtype=$(jq -r '.subtype // empty' <<<"$json" 2>/dev/null || true)
    # The CLI reports the tool calls it refused, so what a phase was blocked from
    # doing is a MEASURED fact rather than something to infer from a bad artifact.
    # This matters most where the permission model is not the default: an empty
    # spec and "17 denials" are the same artifact with very different remedies.
    denials=$(jq -r '(.permission_denials // []) | length' <<<"$json" 2>/dev/null || echo 0)
    if [ "${denials:-0}" -gt 0 ]; then
      denied_tools=$(jq -r '[(.permission_denials // [])[] | (.tool_name // .tool // "?")]
                            | unique | join(", ")' <<<"$json" 2>/dev/null || true)
      denial_note="$denials tool call(s) were DENIED to this phase (${denied_tools:-unknown})"
    fi
  else
    # The check failed, not necessarily the phase. Say which, and leave the
    # figures EMPTY so they record as null rather than as a measured zero.
    unmeasured="the phase's output was not parseable JSON, so cost and turns are UNMEASURED (not zero)"
    cost=""; turns=""; dur=""
    result=$(printf '%s\n%s' "$(printf '%s' "$out" | head -c 1200)" \
                              "$(printf '%s' "$errcap" | head -c 800)")
  fi
  rm -f "$errf"
  [ -n "$cost" ] && RUN_TOTAL=$(awk -v a="$RUN_TOTAL" -v b="$cost" 'BEGIN{printf "%.4f", a+b}')

  if [ -n "$COST_LOG" ]; then
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$(now_iso)" "$id" "$model" "$effort" "${cost:-unmeasured}" \
      "${turns:-unmeasured}" "${dur:-unmeasured}" \
      "${tok_read:-unmeasured}" "${tok_write:-unmeasured}" \
      "${tok_in:-unmeasured}" "${tok_out:-unmeasured}" >> "$COST_LOG"
  fi

  # A non-zero exit is evidence, not a verdict — and a zero exit is not a pass.
  # The artifact decides. But a process that died before writing anything should
  # say so in its own words, so keep the output when things go wrong.
  local status note
  IFS=$'\t' read -r status note < <(verify_phase "$id" "${FEATURE_DIR:-/nonexistent}" "$artifact" \
                                      "$(jq -r '.chunked // false' <<<"$pj")")

  # No parseable result AND a non-zero exit: the phase did not COMPLETE, and what
  # its artifact looks like is beside the point. With --output-format json a normal
  # completion always returns an envelope, so its absence plus a failed exit is
  # conclusive rather than suggestive.
  #
  # Measured: a plan phase killed mid-run (SIGTERM, exit 143, no stdout) had
  # already written a plan.md that ends at a plausible heading — 3088 bytes, no
  # open markers — and verification passed it `ok`. The artifact HAD moved, so the
  # unchanged-artifact rule below could not see it, and the later artifacts a
  # finished plan writes (research.md, data-model.md, contracts/) were simply
  # absent. A rolling restart, a Ctrl-C or an OOM kill all land here.
  if [ -n "$unmeasured" ] && [ "$rc" -ne 0 ]; then
    status=failed
    note="the phase did not complete: exit $rc with no result returned${artifact:+ — $artifact may be partially written}"
    unmeasured=""
  fi

  # The runner said it failed. Believe it, whatever the artifact looks like — a
  # phase that ran out of turns leaves exactly the plausible-looking file that
  # every size-and-marker check passes. `error_max_turns` is also ACTIONABLE in a
  # way a thin artifact is not: the remedy is a higher cap, not a rewrite.
  if [ -n "$cli_error" ]; then
    status=failed
    case "$cli_subtype" in
      error_max_turns)
        note="the phase ran OUT OF TURNS after ${turns:-?} (raise max_turns for '$id' in phases.json)${artifact:+ — $artifact is likely unfinished}";;
      *)
        note="the runner reported failure (${cli_subtype:-unknown})${artifact:+ — $artifact is likely unfinished}";;
    esac
  fi

  # No parseable result AND an artifact that did not move: the phase did not run.
  # Verification against a file its previous attempt wrote is not evidence — this
  # is precisely the tidy pass over work that never happened, and it was measured
  # here (2 seconds, empty output, "ok" over the prior attempt's plan.md).
  if [ -n "$unmeasured" ] && [ "$rc" -eq 0 ] && [ -n "${artifact:-}" ] && [ "$artifact" != null ]; then
    local sha_after
    sha_after=$(file_sha "${FEATURE_DIR:-}/$artifact")
    if [ "$sha_after" = "$sha_before" ]; then
      status=failed
      note="the phase returned no parseable result and did not change $artifact — it appears not to have run at all (exit $rc)"
      unmeasured=""
    fi
  fi
  [ -n "$unmeasured" ] && note="$note; $unmeasured"
  [ -n "$denial_note" ] && note="$note; $denial_note"

  # The phase's own account — including any question it wants answered — goes to
  # disk. A headless phase cannot ask mid-run and wait, so its questions arrive
  # at the end; leaving them in terminal scrollback is how they get lost.
  if [ -n "$FEATURE_DIR" ] && [ -d "$FEATURE_DIR/.pipeline" ]; then
    # An envelope, not the raw stdout: stderr is where a runner explains itself
    # (an unknown option, a refused permission), and writing stdout alone threw
    # away the only account of what went wrong. exit_code is kept for the same
    # reason — it is evidence, even though it is never the verdict.
    jq -n --arg phase "$id" --arg rc "$rc" --arg out "$out" --arg err "$errcap" \
          --argjson parsed "${json:-null}" \
      '{phase:$phase, exit_code:($rc|tonumber? // null), parsed:$parsed,
        stdout:$out, stderr:$err}' \
      > "$FEATURE_DIR/.pipeline/$id.result.json" 2>/dev/null || \
      printf '%s\n%s\n' "$out" "$errcap" > "$FEATURE_DIR/.pipeline/$id.result.json" 2>/dev/null || true
  fi

  # ---- scope check, against the tree as it was when this phase started
  local violations=""
  if [ -n "$snap" ]; then
    violations=$(scope_violations_since "$REPO" "$snap" "${prefixes[@]}")
    rm -f "$snap"
    if [ -n "$violations" ]; then
      status=failed
      note="wrote outside its declared scope (${prefixes[*]}): $(printf '%s' "$violations" | tr '\n' ' ')"
    fi
  fi

  local sha
  sha=$(file_sha "${FEATURE_DIR:-}/${artifact:-nonexistent}")
  if [ -n "$STATE" ]; then
    state_phase_finish "$STATE" "$id" "$status" "$cost" "$turns" "$dur" "$sha" "$note"
    state_phase_set_usage "$STATE" "$id" "$tok_read" "$tok_write" "$tok_in" "$tok_out"
  fi

  case "$status" in
    ok)          ok   "$id — $note  $(dim_s "($(fmt_cost "$cost"), ${turns:-?} turns)")";;
    unevaluated) warn "$id — $note  ($(fmt_cost "$cost"), ${turns:-?} turns)";;
    needs_input) warn "$id — $note  ($(fmt_cost "$cost"), ${turns:-?} turns)";;
    failed)      err  "$id — $note  ($(fmt_cost "$cost"), ${turns:-?} turns, exit $rc)";;
  esac

  if [ "$status" = failed ] || [ "$status" = needs_input ]; then
    printf '\n'
    [ -n "$result" ] && { dim "  the phase's own account:"; printf '  %s\n\n' "$result"; }
    # Name the cause when the account is a terminal complaint rather than
    # anything about the work. Without this the reader gets a Python traceback
    # ending in `termios.error: (19, ...)` and no indication that the runner, and
    # not the phase, is what failed — nor that one flag fixes it. Diagnosis
    # belongs next to the evidence; the reader is looking here already.
    if looks_like_tty_failure "$result"; then
      warn "that is the RUNNER demanding a terminal, not the phase failing at its work"
      say  "  '$CLAUDE_BIN' drives Claude through pexpect, which needs a TTY. This run"
      say  "  has none, so no phase can start and nothing was written."
      say  "  Re-run with: --claude-bin $(jqd "$CONFIG" '.defaults.claude_bin' claude)"
      say  "  (or unset SPEC_RUN_CLAUDE_BIN for non-interactive runs)"
      printf '\n'
    fi
    say "  pick this phase up in conversation:"
    say "    claude --resume $sid"
    say "  then continue the pipeline:"
    say "    spec-run --resume${FROM:+ --from $id}"
    printf '\n'
    [ "$status" = failed ] && return 1
    return 2
  fi

  # A gate is a stop the pipeline owns, not a sentence in a prompt. Prose has
  # already been tried: an agent told "stop before implement" merged two pull
  # requests and deployed them.
  local gate_policy="$gate"
  case "$GATE_OVERRIDE" in
    all)  gate_policy=always;;
    none) gate_policy=never;;
    "")   ;;
    *)    _in_list "$GATE_OVERRIDE" "$id" && gate_policy=always || gate_policy=never;;
  esac
  if [ "$gate_policy" = always ]; then
    printf '\n'
    say "  gate: $id is configured to pause for review."
    say "    review:   ${FEATURE_DIR:-?}/${artifact:-}"
    say "    continue: spec-run --resume"
    printf '\n'
    return 2
  fi

  if [ -n "$STOP_AFTER" ] && [ "$id" = "$STOP_AFTER" ]; then
    printf '\n'; ok "stopped after '$id' as requested"; printf '\n'
    return 2
  fi

  return 0
}

# ---------------------------------------------------------------- driver ------

init_cost_log

say ""
say "spec-run  $(dim_s "repo $REPO")"
[ -n "$FEATURE_DIR" ] && dim "          feature $FEATURE_DIR"
[ -n "$DESCRIPTION" ] && dim "          \"$DESCRIPTION\""
say ""

if [ -z "$DESCRIPTION" ] && [ -z "$FEATURE_DIR" ] && [ -z "$ONLY" ]; then
  die "nothing to resume and no feature description given" \
      "spec-run \"<what you want built>\"   — or run from a branch with a specs/ directory"
fi

reached=""
[ -z "$FROM" ] && reached=1

# What SHOULD run, worked out before anything does. The stdin bug ended the loop
# after one iteration, and the only reason that was invisible is that nothing
# compared the phases executed against the phases selected. A count of what was
# meant to happen turns "the loop ended early" into a detectable event whatever
# the cause — this is the general form of that fix, and the reason it is worth
# having is that the specific fix only covers the specific cause.
phases_selected=""
_sel_i=0
_sel_n=$(jq -r '.phases | length' "$CONFIG")
_sel_reached=""
[ -z "$FROM" ] && _sel_reached=1
while [ "$_sel_i" -lt "$_sel_n" ]; do
  _sel_id=$(jq -r ".phases[$_sel_i].id" "$CONFIG")
  _sel_opt=$(jq -r ".phases[$_sel_i].optional // false" "$CONFIG")
  _sel_i=$((_sel_i + 1))
  if [ -z "$_sel_reached" ]; then
    [ "$_sel_id" = "$FROM" ] && _sel_reached=1 || continue
  fi
  phase_selected "$_sel_id" "$_sel_opt" || continue
  phases_selected="${phases_selected:+$phases_selected }$_sel_id"
done
phases_selected_count=$(printf '%s\n' "$phases_selected" | wc -w | tr -d ' ')

rc_final=0
phases_run=0

# Iterated BY INDEX, not from a stream. `while read; done < <(jq …)` gives the
# loop body a stdin it does not own, and `claude -p` reads stdin — so the first
# phase swallowed every remaining phase's JSON and the loop ended after one
# iteration. Measured on a real roadmap entry: specify ran, plan/tasks/implement
# never did, and the run reported "pipeline complete" with a summary listing one
# phase. Nothing failed; three quarters of the work simply did not happen.
#
# It was invisible to everything: every real run until then had been --only <one
# phase>, and the fake runner in the tests does not read stdin.
n_phases=$(jq -r '.phases | length' "$CONFIG")
i=0
while [ "$i" -lt "$n_phases" ]; do
  pj=$(jq -c ".phases[$i]" "$CONFIG")
  i=$((i + 1))

  id=$(jq -r '.id' <<<"$pj")
  optional=$(jq -r '.optional // false' <<<"$pj")

  if [ -z "$reached" ]; then
    [ "$id" = "$FROM" ] && reached=1 || { dim "  · $id — before --from $FROM, skipping"; continue; }
  fi
  phase_selected "$id" "$optional" || { dim "  · $id — not selected"; continue; }

  phases_run=$((phases_run + 1))
  if [ "$(jq -r '.chunked // false' <<<"$pj")" = true ] && [ -n "${FEATURE_DIR:-}" ]; then
    run_phase_chunked "$pj"; rc=$?
  else
    run_phase "$pj"; rc=$?
  fi
  if [ "$rc" -ne 0 ]; then rc_final=$rc; break; fi
done

# ---------------------------------------------------------------- summary -----

say ""
if [ -n "$STATE" ] && [ -f "$STATE" ] && [ "$DRY_RUN" -eq 0 ]; then
  say "summary"
  printf '  %-10s %-8s %-7s %-12s %10s %6s\n' PHASE MODEL EFFORT STATUS COST TURNS
  jq -r '.phases | to_entries[] |
         [.key, (.value.model // "-"), (.value.effort // "-"), (.value.status // "-"),
          (if .value.cost_usd == null then "unmeasured" else "$" + (.value.cost_usd|tostring) end),
          (if .value.num_turns == null then "?" else (.value.num_turns|tostring) end)] | @tsv' "$STATE" |
    while IFS=$'\t' read -r a b c d e f; do
      printf '  %-10s %-8s %-7s %-12s %10s %6s\n' "$a" "$b" "$c" "$d" "$e" "$f"
    done
  printf '  %-10s %-8s %-7s %-12s %10s\n' TOTAL "" "" "" "\$$(state_total_cost "$STATE")"
  dim "  state: $STATE"
  print_token_profile "$STATE"
  say ""
fi

# A run that executed nothing is not a success, whatever emptied the selection.
# The named-phase check above catches the common cause; this catches the rest,
# because "everything was already ok" and "nothing was selected" print almost
# identically and only one of them means the work is done.
if [ "$rc_final" -eq 0 ] && [ "$phases_run" -eq 0 ]; then
  err "no phase ran"
  printf '  Every configured phase was filtered out by the selection.\n' >&2
  printf '  Selected: %s\n' "${ONLY:-all}${WITH:+ (+$WITH)}${FROM:+ from $FROM}" >&2
  printf '  Configured: %s\n' "$(printf '%s' "$KNOWN_PHASES" | tr ',' ' ')" >&2
  exit 1
fi

# A clean exit that ran fewer phases than it selected did not finish, whatever
# the reason. Anything that stops deliberately — a gate, needs_input, a failure —
# has already returned non-zero, so reaching here with a shortfall means the loop
# ended without deciding to.
if [ "$rc_final" -eq 0 ] && [ "$phases_run" -lt "$phases_selected_count" ]; then
  err "only $phases_run of $phases_selected_count selected phases ran, and nothing reported a reason"
  printf '  Selected: %s\n' "$phases_selected" >&2
  printf '  This is a bug in spec-run, not in your project: the phase loop ended\n' >&2
  printf '  early without a gate, a failure or a question. Please report it with\n' >&2
  printf '  the state file at %s\n' "${STATE:-<no state file>}" >&2
  exit 1
fi

exit "$rc_final"
